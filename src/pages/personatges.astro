---
import Layout from '../components/Layout.astro';
import { publicFigures } from '../data/publicFigures';
const initials = (name: string) => name.split(/\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase();
const years = (figure: typeof publicFigures[number]) => [figure.birth_year, figure.death_year].filter((year) => year !== null).join('–');
---
<Layout title="Personatges" description="Personatges que han contribuït a la història de la informàtica.">
  <section class="page-intro compact-intro"><p class="eyebrow">MEMÒRIA HUMANA // ARXIU OBERT</p><h1>Personatges que van <em>fer sistema.</em></h1><p class="lead">Idees, oficis i trajectòries que ajuden a llegir la història de la informàtica més enllà de les màquines.</p></section>
  <section class="figures-page" aria-labelledby="figures-results-title">
    <form class="figures-filters" data-figures-form><label>Cerca per nom o paraula clau<input type="search" name="q" autocomplete="off" placeholder="Ex.: programació, xarxes…" /></label><label>Àmbit<select name="scope" data-scope><option value="">Tots els àmbits</option>{[...new Set(publicFigures.map((figure) => figure.field))].sort().map((field) => <option value={field}>{field}</option>)}</select></label><button class="filter-reset" type="reset">Netejar filtres</button></form>
    <p class="result-count" data-figures-status role="status" aria-live="polite">{publicFigures.length} personatges disponibles.</p>
    <h2 id="figures-results-title" class="sr-only">Resultats de personatges</h2>
    <div class="figures-grid" data-figures>{publicFigures.map((figure) => <article class="figure-card"><div class="figure-card-visual" aria-hidden="true">{initials(figure.full_name)}</div><div class="figure-card-body"><p class="eyebrow">{figure.field} · {years(figure)}</p><h2><a href={`${import.meta.env.BASE_URL}personatges/detall/?slug=${encodeURIComponent(figure.slug)}#${encodeURIComponent(figure.slug)}`}>{figure.full_name}</a></h2><p>{figure.summary}</p><a class="piece-cta" href={`${import.meta.env.BASE_URL}personatges/detall/?slug=${encodeURIComponent(figure.slug)}#${encodeURIComponent(figure.slug)}`}>Llegir la fitxa <span aria-hidden="true">→</span></a></div></article>)}</div>
    <noscript><p class="config-notice">Estàs consultant les sis fitxes de referència disponibles sense JavaScript.</p></noscript>
  </section>
</Layout>
<script>
  import { publicFigures } from '../data/publicFigures';
  import { supabase } from '../lib/supabase';
  type Figure = Record<string, any>;
  const list = document.querySelector<HTMLElement>('[data-figures]')!; const form = document.querySelector<HTMLFormElement>('[data-figures-form]')!; const scopeSelect = document.querySelector<HTMLSelectElement>('[data-scope]')!; const status = document.querySelector<HTMLElement>('[data-figures-status]')!;
  let figures: Figure[] = publicFigures;
  const value = (item: Figure, ...keys: string[]) => keys.map(key => item[key]).find(item => item !== null && item !== undefined && item !== '') || '';
  const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || '??';
  const years = (item: Figure) => value(item, 'life_dates', 'years') || [value(item, 'birth_year'), value(item, 'death_year')].filter(year => year !== null && year !== '').join('–');
  function makeCard(item: Figure) { const name = String(value(item, 'name', 'full_name', 'title')); const scope = String(value(item, 'scope', 'area', 'field')); const article = document.createElement('article'); article.className = 'figure-card'; const visual = document.createElement('div'); visual.className = 'figure-card-visual'; visual.setAttribute('aria-hidden', 'true'); const imageUrl = value(item, 'resolved_image_url', 'image_url', 'image_public_url'); if (imageUrl) { const image = document.createElement('img'); image.src = imageUrl; image.alt = ''; image.width = 720; image.height = 900; image.loading = 'lazy'; image.decoding = 'async'; image.addEventListener('error', () => { image.remove(); visual.textContent = initials(name); }); visual.append(image); } else visual.textContent = initials(name); const body = document.createElement('div'); body.className = 'figure-card-body'; const meta = document.createElement('p'); meta.className = 'eyebrow'; meta.textContent = [scope, years(item)].filter(Boolean).join(' · ') || 'FITXA BIOGRÀFICA'; const title = document.createElement('h2'); const link = document.createElement('a'); link.href = `${import.meta.env.BASE_URL}personatges/detall/?slug=${encodeURIComponent(String(item.slug))}#${encodeURIComponent(String(item.slug))}`; link.textContent = name; title.append(link); const summary = document.createElement('p'); summary.textContent = String(value(item, 'summary', 'excerpt', 'description') || 'Fitxa biogràfica en procés de documentació.'); const action = document.createElement('a'); action.className = 'piece-cta'; action.href = link.href; action.innerHTML = 'Llegir la fitxa <span aria-hidden="true">→</span>'; body.append(meta, title, summary, action); article.append(visual, body); return article; }
  function render() { const data = new FormData(form); const q = String(data.get('q') || '').trim().toLocaleLowerCase(); const scope = String(data.get('scope') || ''); const shown = figures.filter(item => { const text = [value(item, 'name', 'full_name', 'title'), value(item, 'summary', 'excerpt', 'description'), value(item, 'scope', 'area', 'field')].join(' ').toLocaleLowerCase(); return (!q || text.includes(q)) && (!scope || value(item, 'scope', 'area', 'field') === scope); }); list.replaceChildren(...shown.map(makeCard)); status.textContent = shown.length ? `${shown.length} ${shown.length === 1 ? 'personatge trobat' : 'personatges trobats'}.` : 'No hi ha cap personatge amb aquests filtres.'; }
  function setScopes(items: Figure[]) { const current = scopeSelect.value; scopeSelect.replaceChildren(new Option('Tots els àmbits', '')); [...new Set(items.map(item => String(value(item, 'scope', 'area', 'field'))).filter(Boolean))].sort().forEach(scope => scopeSelect.add(new Option(scope, scope))); scopeSelect.value = current; }
  setScopes(figures); form.addEventListener('input', render); form.addEventListener('change', render); form.addEventListener('reset', () => requestAnimationFrame(render));
  if (supabase) { const { data, error } = await supabase.from('public_historical_figures').select('*').order('full_name'); if (!error && data) { figures = data; const paths = figures.map(item => item.image_path).filter(Boolean); if (paths.length) { const { data: signed } = await supabase.storage.from('historical-figure-images').createSignedUrls(paths, 3600); const urls = new Map((signed || []).filter(file => file.path && file.signedUrl).map(file => [file.path, file.signedUrl])); figures.forEach(item => item.resolved_image_url = urls.get(item.image_path) || ''); } setScopes(figures); render(); } }
</script>
