---
import Layout from '../../components/Layout.astro';
---
<Layout title="Fitxa de catàleg">
   <section class="detail-page" data-detail aria-live="polite">
    <p><a class="back-link" data-back-link href={`${import.meta.env.BASE_URL}cataleg/`}>← Torna al catàleg</a></p>
    <div class="detail-hero"><div class="detail-visual" data-detail-photos><p class="photo-fallback">Fotografia pendent</p></div><div><p class="eyebrow">CATÀLEG <span data-year></span></p><h1 data-title>Carregant la <em>fitxa.</em></h1><p class="lead" data-description></p><div class="detail-hashtags" data-detail-tags aria-label="Etiquetes"></div></div></div>
   <p class="form-message" data-detail-message role="status"></p><section class="detail-story" data-story hidden><h2>Per què és important?</h2><p data-importance></p><div data-history hidden><h2>Història i ús</h2><p data-history-text></p></div></section><section data-meta-section hidden><h2>Metadades</h2><dl data-detail-meta class="detail-meta"></dl></section><noscript><p class="config-notice">Aquesta fitxa necessita JavaScript per consultar el catàleg en temps real. Torna al <a href={`${import.meta.env.BASE_URL}cataleg/`}>catàleg</a>.</p></noscript>
  </section>
</Layout>
<script>
  import { supabase } from '../../lib/supabase';
  import { pieces } from '../../data/pieces';
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const params = new URLSearchParams(location.search), id = params.get('id'); params.delete('id'); $('[data-back-link]').setAttribute('href', `${import.meta.env.BASE_URL}cataleg/${params.size ? `?${params}` : ''}`);
   const addMeta = (label: string, value: string | number | null | undefined, href?: string | null) => { if (!value) return; const group = document.createElement('div'), term = document.createElement('dt'), detail = document.createElement('dd'); term.textContent = label; if (href?.startsWith('https://')) { const link = document.createElement('a'); link.href = href; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = `Obrir ${label.toLowerCase()} en una pestanya nova`; detail.append(link); } else detail.textContent = String(value); group.append(term, detail); $('[data-detail-meta]').append(group); };
   const showFallback = () => { const fallback = document.createElement('p'); fallback.className = 'photo-fallback'; fallback.textContent = 'Fotografia pendent'; $('[data-detail-photos]').replaceChildren(fallback); };
   const showImage = (src: string, alt: string) => { const image = document.createElement('img'); image.src = src; image.alt = alt; image.width = 960; image.height = 720; image.decoding = 'async'; image.addEventListener('error', showFallback, { once: true }); $('[data-detail-photos]').replaceChildren(image); };
   const addPhoto = (src: string, alt: string, caption?: string | null) => { const figure = document.createElement('figure'), image = document.createElement('img'); image.src = src; image.alt = alt; image.width = 960; image.height = 720; image.loading = 'lazy'; image.decoding = 'async'; image.addEventListener('error', () => { figure.replaceChildren(Object.assign(document.createElement('p'), { className: 'photo-fallback', textContent: 'Fotografia pendent' })); }, { once: true }); figure.append(image); if (caption) { const text = document.createElement('figcaption'); text.textContent = caption; figure.append(text); } $('[data-detail-photos]').append(figure); };
   const addTags = (values: string[]) => values.forEach(value => { const tag = document.createElement('span'); tag.className = 'hashtag'; tag.textContent = `#${value}`; $('[data-detail-tags]').append(tag); });
   const showLocalPiece = (piece: typeof pieces[number]) => { $('[data-title]').textContent = piece.name; $('[data-year]').textContent = `· ${piece.year}`; $('[data-description]').textContent = piece.note; $('[data-importance]').textContent = piece.note; $('[data-history-text]').textContent = piece.note; $('[data-story]').hidden = false; ['Tipologia', 'Ubicació', 'Referència'].forEach((label, index) => addMeta(label, [piece.type, piece.location, piece.mark][index])); $('[data-meta-section]').hidden = false; addTags([piece.type.toLowerCase(), piece.location.toLowerCase()]); showImage(piece.imagePublicUrl || `${import.meta.env.BASE_URL}${piece.image}`, piece.imageAlt); };
   const localPiece = pieces.find(item => item.mark === id);
   if (!supabase || !id) {
     if (!localPiece) { $('[data-title]').textContent = 'Fitxa no disponible.'; $('[data-detail-message]').textContent = 'Tria una peça des del catàleg per consultar-ne el detall.'; }
     else showLocalPiece(localPiece);
   } else {
     let piece: any = null, error: unknown = null;
     try { ({ data: piece, error } = await supabase.from('catalog_objects').select('id,inventory_code,title,description,manufacturer,model,serial_number,production_year_start,production_year_end,period_label,ownership,physical_condition,condition_notes,information_url,video_url,object_types(name),cabinets(code,building,cabinet,shelf),object_tags(tags(name,normalized_name))').eq('id', id).eq('status', 'published').single()); } catch (requestError) { error = requestError; }
      if (error || !piece) { if (localPiece) { showLocalPiece(localPiece); $('[data-detail-message]').textContent = 'Aquesta és una fitxa de mostra perquè no s’ha pogut actualitzar des del catàleg.'; } else { $('[data-title]').textContent = 'Fitxa no trobada.'; $('[data-detail-message]').textContent = 'Aquesta peça no existeix o encara no és pública.'; } }
     else {
       const objectType = piece.object_types as unknown as { name: string } | null, cabinet = piece.cabinets as unknown as { code: string; building: string; cabinet: string; shelf: string | null } | null, year = [piece.production_year_start, piece.production_year_end].filter(Boolean).join('–') || piece.period_label || '';
       $('[data-title]').textContent = piece.title; $('[data-year]').textContent = year ? `· ${year}` : ''; $('[data-description]').textContent = piece.description || [piece.manufacturer, piece.model].filter(Boolean).join(' · ') || 'Fitxa documental del Museu d’Informàtica.'; $('[data-importance]').textContent = piece.description || 'La fitxa està en procés de documentació.'; $('[data-history-text]').textContent = piece.description || ''; $('[data-story]').hidden = false; addMeta('Tipologia', objectType?.name); addMeta('Fabricant', piece.manufacturer); addMeta('Model', piece.model); addMeta('Datació', year); if ($('[data-detail-meta]').childElementCount) $('[data-meta-section]').hidden = false;
       addMeta('Codi d’inventari', piece.inventory_code); addMeta('Número de sèrie', piece.serial_number); addMeta('Propietat', piece.ownership); addMeta('Estat de conservació', piece.physical_condition); addMeta('Notes de conservació', piece.condition_notes); addMeta('Ubicació', cabinet ? [cabinet.code, cabinet.building, cabinet.cabinet, cabinet.shelf].filter(Boolean).join(' · ') : null); addMeta('Documentació', piece.information_url, piece.information_url); addMeta('Vídeo', piece.video_url, piece.video_url); if ($('[data-detail-meta]').childElementCount) $('[data-meta-section]').hidden = false;
       const tags = (piece.object_tags as unknown as { tags: { name: string; normalized_name: string } | null }[] | null) || []; addTags(tags.flatMap(row => row.tags ? [row.tags.normalized_name || row.tags.name] : []));
        try { const { data: photos, error: photosError } = await supabase.from('object_photos').select('storage_path,alt_text,caption').eq('object_id', piece.id).order('position'); if (photosError) throw photosError; if (photos?.length) { const { data: signed, error: signedError } = await supabase.storage.from('catalog-photos').createSignedUrls(photos.map(photo => photo.storage_path), 3600); if (signedError) throw signedError; const urls = new Map(signed?.filter(file => file.path && file.signedUrl).map(file => [file.path, file.signedUrl]) || []); const resolved = photos.filter(photo => urls.has(photo.storage_path)); if (resolved.length) { $('[data-detail-photos]').replaceChildren(); $('[data-detail-photos]').dataset.gallery = ''; resolved.forEach(photo => addPhoto(urls.get(photo.storage_path)!, photo.alt_text || '', photo.caption)); } } } catch { $('[data-detail-message]').textContent = 'Galeria no disponible.'; }
     }
  }
</script>
