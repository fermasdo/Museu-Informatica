---
import Layout from '../components/Layout.astro';
---
<Layout title="Col·labora">
  <section class="page-intro"><p class="eyebrow">COL·LABORACIÓ</p><h1>Un museu<br /><em>compartit.</em></h1><p class="lead">Accedeix al teu espai per inventariar, revisar i aportar context a la col·lecció. El professorat assigna els permisos de col·laboració.</p></section>
  <section class="account-area" aria-labelledby="access-title">
    <div class="section-heading"><div><p class="eyebrow">ESPAI DE GESTIÓ</p><h2 id="access-title">Accés al projecte</h2></div></div>
    <p class="form-message" data-message role="status" aria-live="polite"></p>
    <div class="config-notice" data-unconfigured hidden><b>El tauler encara no està connectat.</b> Configura les variables públiques de Supabase per activar l’accés; la resta del web continua disponible.</div>
    <div class="auth-grid" data-auth-area>
      <form data-login><h3>Inicia sessió</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="current-password" required /></label><button class="button" type="submit">Entrar <span aria-hidden="true">→</span></button><button class="link-button" type="button" data-show-reset>He oblidat la contrasenya</button></form>
      <form data-signup><h3>Crea un compte</h3><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><fieldset class="role-choice"><legend>Tipus de col·laboració</legend><label><input name="requested_role" type="radio" value="student" required /> Alumnat</label><label><input name="requested_role" type="radio" value="teacher" required /> Professorat</label></fieldset><button class="button" type="submit">Registrar-me <span aria-hidden="true">→</span></button><p class="form-note">Rebràs un correu de confirmació si el projecte el requereix. Aquesta elecció és una sol·licitud: no dona permisos fins que el professorat o l’administració la valide.</p></form>
      <form data-reset hidden><h3>Recupera la contrasenya</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><button class="button" type="submit">Enviar enllaç</button><button class="link-button" type="button" data-hide-reset>Tornar a l’accés</button></form>
      <form data-new-password hidden><h3>Tria una contrasenya nova</h3><label>Contrasenya nova<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><button class="button" type="submit">Actualitzar contrasenya</button></form>
    </div>
    <section class="dashboard" data-dashboard hidden aria-labelledby="dashboard-title">
      <div class="dashboard-header"><div><p class="eyebrow">EL MEU ESPAI</p><h2 id="dashboard-title">Hola, <span data-profile-name></span></h2><p data-profile-summary></p></div><button class="button button-quiet" type="button" data-signout>Tancar sessió</button></div>
      <div class="profile-card"><p class="eyebrow">PERFIL</p><dl><div><dt>Correu</dt><dd data-profile-email></dd></div><div><dt>Rol efectiu</dt><dd data-profile-role></dd></div><div><dt>Sol·licitud</dt><dd data-profile-requested-role></dd></div><div><dt>Estat</dt><dd data-profile-approval></dd></div></dl><p class="form-note">La sol·licitud de col·laboració no concedeix permisos per si mateixa; cal que siga validada.</p></div>
      <div data-student-dashboard hidden>
        <div class="dashboard-section"><div><p class="eyebrow">LES MEUES FITXES</p><h3>Inventari en curs</h3></div><div data-own-objects class="dashboard-list"></div></div>
        <div class="dashboard-section"><p class="eyebrow">NOVA FITXA</p><h3>Crea un esborrany</h3><form class="data-form" data-object-form><p class="form-note">El codi d’inventari s’assigna automàticament en desar.</p><label>Títol<input name="title" minlength="2" maxlength="180" required /></label><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" placeholder="Dècada de 1980" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><p class="form-note">Les fitxes en préstec requereixen dades privades que només gestiona el professorat; demana’ls ajuda abans d’enviar-ne una.</p><button class="button" type="submit">Desar esborrany</button></form></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSA UN CANVI</p><h3>Millora una peça publicada</h3><form class="data-form" data-proposal-form><label>Peça publicada<select name="object_id" data-published-objects required><option value="">Carregant…</option></select></label><label>Assumpte<input name="subject" minlength="4" maxlength="180" required /></label><label>Proposta<textarea name="message" rows="5" minlength="10" maxlength="5000" required></textarea></label><button class="button" type="submit">Enviar proposta</button></form><h4>Les meues propostes</h4><div class="dashboard-list" data-own-proposals></div></div>
        <div id="anuncis" class="dashboard-section"><p class="eyebrow">ARXIU AUDIOVISUAL</p><h3>Proposa un anunci</h3><form class="data-form" data-video-proposal-form><label>Títol<input name="title" minlength="4" maxlength="180" required /></label><div class="form-row"><label>Any<input name="era" type="number" min="1800" max="2200" required /></label><label>Tipologia<select name="category"><option>Ordinador personal</option><option>Consola</option><option>Videojoc</option><option>Programari</option></select></label></div><label>Enllaç de YouTube<input name="video_url" type="url" placeholder="https://www.youtube.com/…" required /></label><label>Context <span class="sr-only">(opcional)</span><textarea name="description" rows="3" maxlength="2000"></textarea></label><button class="button" type="submit">Enviar per revisar</button></form></div>
      </div>
      <div data-pending-dashboard hidden class="config-notice" role="status"><b data-pending-title></b> <span data-pending-message></span></div>
      <div data-teacher-dashboard hidden>
        <div class="dashboard-section"><p class="eyebrow">PERSONES COL·LABORADORES</p><h3>Perfils</h3><div class="dashboard-list" data-teacher-profiles></div></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">NOVA FITXA</p><h3>Afig una peça al catàleg</h3><form class="data-form" data-teacher-object-form><div class="form-row"><label>Codi d’inventari<input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" placeholder="MUS-001" required /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-teacher-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-teacher-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" placeholder="Dècada de 1980" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><p class="form-note">Si és un préstec, desa la fitxa i gestiona després les dades privades del préstec. No s’afegeixen dades de donants ací.</p><fieldset class="role-choice"><legend>Visibilitat inicial</legend><label><input name="status" type="radio" value="draft" checked /> Desar com a esborrany</label><label><input name="status" type="radio" value="published" /> Publicar directament</label></fieldset><button class="button" type="submit">Crear fitxa <span aria-hidden="true">→</span></button></form></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">TAXONOMIES I UBICACIONS</p><h3>Prepara el catàleg</h3><div class="catalogue-settings-grid"><div><h4>Tipologies</h4><form class="data-form" data-object-type-form><label>Nom<input name="name" minlength="2" maxlength="80" required /></label><label>Descripció <span class="sr-only">(opcional)</span><textarea name="description" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Afegir tipologia</button></form><div class="dashboard-list" data-object-types-list></div></div><div><h4>Ubicacions</h4><form class="data-form" data-cabinet-form><div class="form-row"><label>Codi<input name="code" pattern="[A-Za-z0-9_-]{1,30}" required /></label><label>Sala<input name="room" maxlength="80" required /></label></div><label>Prestatge <span class="sr-only">(opcional)</span><input name="shelf" maxlength="40" /></label><label>Notes <span class="sr-only">(opcional)</span><textarea name="notes" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Afegir ubicació</button></form><div class="dashboard-list" data-cabinets-list></div></div></div></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">GESTIÓ DEL CATÀLEG</p><h3>Fitxes recents</h3><label>Filtra per estat<select data-review-filter><option value="">Totes</option><option value="pending_review">Pendents de revisió</option><option value="draft">Esborranys</option><option value="published">Publicades</option><option value="archived">Arxivades</option></select></label><p class="form-note">Mostra esborranys, fitxes pendents de revisió, publicades i arxivades.</p><div class="dashboard-list" data-review-objects></div></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSTES</p><h3>Canvis rebuts</h3><div class="dashboard-list" data-proposals></div></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">ANUNCIS PROPOSATS</p><h3>Revisa l’arxiu audiovisual</h3><div class="dashboard-list" data-video-proposals></div></div>
      </div>
    </section>
  </section>
  <section class="collaborate"><article><p class="eyebrow">VISITA</p><h2>Vine als corredors</h2><p>Per a grups externs o visites comentades, escriu-nos amb antelació.</p><a class="text-link" href="mailto:museu.informatica@iesestacio.com">Demanar una visita →</a></article><article><p class="eyebrow">COL·LABORA</p><h2>Comparteix coneixement</h2><p>Busquem memòries d’ús, documentació i experiències professionals.</p><a class="text-link" href="#donacions">Proposar una col·laboració →</a></article><article><p class="eyebrow">PROJECTE</p><h2>Aprendre del que queda</h2><p>Conservar és donar context: preguntar qui ho va dissenyar, qui ho usava i què va fer possible.</p></article></section>
  <section id="donacions" class="form-layout"><div><p class="eyebrow">CUSTODIAR, NO ACUMULAR</p><h2>Dona una <em>història.</em></h2><p class="lead">Abans de desfer-te d’un ordinador, consola, perifèric o manual, conta’ns què és i d’on ve.</p><p>Revisarem cada proposta amb cura. No tot entrarà a la col·lecció, però tota memòria ens ajuda a documentar-la millor.</p></div><form data-donation-form><div class="form-row"><label>Nom i cognoms<input name="name" autocomplete="name" required /></label><label>Correu electrònic<input type="email" name="email" autocomplete="email" required /></label></div><label>Telèfon <span class="sr-only">(opcional)</span><input name="phone" autocomplete="tel" /></label><label>Quin objecte vols proposar?<input name="object" required placeholder="Ex.: ordinador, joc, manual…" /></label><label>La seua història<textarea name="story" rows="5" required placeholder="Marca, any aproximat, estat, com va arribar a tu…"></textarea></label><label class="sr-only" aria-hidden="true">No emplenes aquest camp<input name="website" tabindex="-1" autocomplete="off" /></label><label class="check"><input name="consent" type="checkbox" required /> <span>Accepte que em contacten sobre aquesta proposta.</span></label><p class="form-note">Guardem el consentiment per gestionar aquesta proposta, versió 2026-10.</p><button class="button" type="submit">Enviar proposta <span aria-hidden="true">→</span></button><p class="form-note" data-donation-message aria-live="polite"></p></form></section>
</Layout>

<template data-teacher-edit-template>
  <details class="object-editor"><summary>Editar dades i enllaços</summary><form class="data-form" data-object-edit-form><div class="form-row"><label>Codi d’inventari<input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" required /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" required></select></label><label>Vitrina / armari<select name="cabinet_id"></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><label>Enllaç a més informació<input name="information_url" type="url" placeholder="https://…" /></label><label>Vídeo relacionat<input name="video_url" type="url" placeholder="https://…" /></label><p class="form-note">Les dades privades de préstecs es gestionen posteriorment.</p><button class="small-button" type="submit">Desar canvis</button></form></details>
</template>

<template data-photo-manager-template>
  <details class="object-editor photo-manager"><summary>Gestionar fotografies</summary><div class="photo-manager-content"><form class="data-form" data-photo-form><label>Fitxer (JPEG, PNG o WebP; màxim 10 MiB)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required /></label><label>Text alternatiu<input name="alt_text" minlength="4" maxlength="250" required /></label><label>Peu de foto <span class="sr-only">(opcional)</span><textarea name="caption" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Pujar fotografia</button></form><div class="photo-list" data-photo-list></div></div></details>
</template>

<script>
  import { supabase } from '../lib/supabase';
  const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
  let donationCaptchaToken = '';
  type Profile = { id: string; display_name: string; role: 'visitor' | 'student' | 'teacher'; requested_role: 'student' | 'teacher' | null; approval_status: string };
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const setMessage = (text: string, error = false) => { message.textContent = text; message.classList.toggle('is-error', error); };
   const human = (value: string) => ({ visitor: 'Visitant', student: 'Alumne/a', teacher: 'Professor/a', not_required: 'No cal aprovació', pending: 'Pendent', approved: 'Aprovat', rejected: 'Rebutjat', draft: 'Esborrany', pending_review: 'Pendent de revisió', open: 'Oberta', accepted: 'Acceptada', implemented: 'Implementada', archived: 'Arxivada', published: 'Publicada' }[value] || value);
  const authArea = $('[data-auth-area]'), dashboard = $('[data-dashboard]');
  const add = (parent: HTMLElement, tag: string, text: string, className?: string) => { const element = document.createElement(tag); element.textContent = text; if (className) element.className = className; parent.append(element); return element; };
  if (!supabase) { $('[data-unconfigured]').hidden = false; authArea.hidden = true; }
   type CatalogueOption = { id: string; name?: string; code?: string; room?: string; title?: string; inventory_code?: string };
   const selectOptions = (selector: string, rows: CatalogueOption[], label: (row: CatalogueOption) => string, optional = false) => { document.querySelectorAll<HTMLSelectElement>(selector).forEach(select => { select.replaceChildren(new Option(optional ? 'Sense assignar' : 'Tria una opció', '')); rows.forEach(row => select.add(new Option(label(row), row.id))); }); };
  async function loadDashboard(user: { id: string; email?: string }) {
    if (!supabase) return;
    const { data: profile, error } = await supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('id', user.id).single();
    if (error || !profile) { setMessage('No s’ha pogut carregar el perfil. Torna-ho a provar.', true); return; }
    authArea.hidden = true; dashboard.hidden = false;
     let { data: administratorResult } = await supabase.rpc('is_administrator');
     if (administratorResult !== true && user.email?.toLowerCase() === 'f.masdomenech@edu.gva.es') { await supabase.rpc('bootstrap_administrator'); ({ data: administratorResult } = await supabase.rpc('is_administrator')); }
     const isAdministrator = administratorResult === true;
    $('[data-profile-name]').textContent = profile.display_name; $('[data-profile-email]').textContent = user.email || '—'; $('[data-profile-role]').textContent = human(profile.role); $('[data-profile-requested-role]').textContent = profile.requested_role ? human(profile.requested_role) : 'Sense sol·licitud'; $('[data-profile-approval]').textContent = human(profile.approval_status); $('[data-profile-summary]').textContent = isAdministrator ? 'Administra les sol·licituds de col·laboració i la revisió del catàleg.' : profile.role === 'teacher' ? 'Gestiona les col·laboracions d’alumnat i la revisió del catàleg.' : `Rol: ${human(profile.role)} · ${human(profile.approval_status)}.`;
    const student = profile.role === 'student' && profile.approval_status === 'approved';
    const pendingNotice = $('[data-pending-dashboard]'), pendingTitle = $('[data-pending-title]'), pendingMessage = $('[data-pending-message]');
    const teacherRequest = profile.requested_role === 'teacher';
    const awaitingApproval = profile.approval_status === 'pending' && (profile.role === 'student' || teacherRequest);
    const rejectedTeacherRequest = teacherRequest && profile.approval_status === 'rejected';
    pendingNotice.hidden = !(awaitingApproval || rejectedTeacherRequest);
    if (teacherRequest && profile.approval_status === 'pending') { pendingTitle.textContent = 'Sol·licitud docent pendent.'; pendingMessage.textContent = 'L’administració ha de validar-la abans que tingues permisos de professorat.'; }
    else if (rejectedTeacherRequest) { pendingTitle.textContent = 'Sol·licitud docent rebutjada.'; pendingMessage.textContent = 'El teu compte continua com a visitant i no té permisos de professorat.'; }
    else { pendingTitle.textContent = 'Compte pendent d’aprovació.'; pendingMessage.textContent = 'Un/a professor/a ha de validar el teu perfil abans que pugues crear fitxes i propostes.'; }
      const canManageCatalogue = profile.role === 'teacher' || isAdministrator === true;
     $('[data-student-dashboard]').hidden = !student; $('[data-teacher-dashboard]').hidden = !(canManageCatalogue || isAdministrator);
     document.querySelectorAll<HTMLElement>('[data-catalogue-management]').forEach(section => section.hidden = !canManageCatalogue);
     if (student) await loadStudent(user.id); if (canManageCatalogue || isAdministrator) await loadTeacher(isAdministrator, canManageCatalogue);
  }
  async function loadStudent(id: string) {
    if (!supabase) return;
     const [objects, types, cabinets, published, proposals] = await Promise.all([
       supabase.from('catalog_objects').select('id, inventory_code, title, description, manufacturer, model, object_type_id, cabinet_id, production_year_start, production_year_end, period_label, ownership, information_url, video_url, status, updated_at').eq('created_by', id).order('updated_at', { ascending: false }),
      supabase.from('object_types').select('id, name').order('name'), supabase.from('cabinets').select('id, code, room').order('code'),
       supabase.from('catalog_objects').select('id, title, inventory_code').eq('status', 'published').order('title'),
       supabase.from('change_proposals').select('subject, message, status, reviewer_note, catalog_objects(title)').eq('submitted_by', id).order('created_at', { ascending: false })
    ]);
     studentTypes = types.data || []; studentCabinets = cabinets.data || [];
     const objectIds = (objects.data || []).map(row => row.id);
     const { data: objectPhotos } = objectIds.length ? await supabase.from('object_photos').select('id, object_id, storage_path, alt_text, caption, position, created_at').in('object_id', objectIds).order('position') : { data: [] as ObjectPhoto[] };
     const list = $('[data-own-objects]'); list.replaceChildren(); if (objects.data?.length) objects.data.forEach(row => { const item = document.createElement('article'); const details = document.createElement('div'); add(details, 'b', row.title); add(details, 'span', `${row.inventory_code} · ${human(row.status)}`); item.append(details); if (row.status === 'draft') { const controls = document.createElement('div'); const edit = add(controls, 'button', 'Editar', 'small-button') as HTMLButtonElement; edit.type = 'button'; edit.onclick = () => openStudentEditor(item, row, id); const submit = add(controls, 'button', 'Enviar a revisió', 'small-button') as HTMLButtonElement; submit.type = 'button'; submit.onclick = () => submitForReview(row.id, id); item.append(controls); const photoFragment = ($('[data-photo-manager-template]') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment; const photoForm = photoFragment.querySelector<HTMLFormElement>('[data-photo-form]')!; photoForm.addEventListener('submit', event => uploadStudentPhoto(event, row.id, (objectPhotos || []).filter(photo => photo.object_id === row.id), id)); item.append(photoFragment); } list.append(item); }); else add(list, 'p', 'Encara no has creat cap fitxa.');
      selectOptions('[data-object-types]', studentTypes, row => row.name || ''); selectOptions('[data-cabinets]', studentCabinets, row => `${row.code} · ${row.room}`, true); selectOptions('[data-published-objects]', published.data || [], row => `${row.title} (${row.inventory_code})`); renderStudentPhotoLists((objects.data || []).filter(row => row.status === 'draft'), objectPhotos || [], id); renderOwnProposals(proposals.data || []);
  }
    let teacherTypes: CatalogueOption[] = [], teacherCabinets: CatalogueOption[] = [], studentTypes: CatalogueOption[] = [], studentCabinets: CatalogueOption[] = [], activeTeacher = false, activeAdministrator = false;
    type ObjectPhoto = { id: string; object_id: string; storage_path: string; alt_text: string; caption: string | null; position: number | null; created_at: string | null };
   async function loadTeacher(isAdministrator: boolean, canManageCatalogue: boolean) {
     if (!supabase) return;
      activeTeacher = canManageCatalogue; activeAdministrator = isAdministrator;
     const [profiles, objects, proposals, types, cabinets] = await Promise.all([
       (isAdministrator
         ? supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('approval_status', 'pending').order('created_at', { ascending: false })
         : supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('role', 'student').order('created_at', { ascending: false })),
        canManageCatalogue ? supabase.from('catalog_objects').select('id, inventory_code, title, description, manufacturer, model, object_type_id, cabinet_id, production_year_start, production_year_end, period_label, ownership, information_url, video_url, status, updated_at').in('status', ['draft', 'pending_review', 'published', 'archived']).order('updated_at', { ascending: false }).limit(50) : Promise.resolve({ data: [], error: null }),
        supabase.from('change_proposals').select('id, subject, message, status, reviewer_note, catalog_objects(title)').order('created_at', { ascending: false }),
