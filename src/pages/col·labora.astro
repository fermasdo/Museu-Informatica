---
import Layout from '../components/Layout.astro';
---
<Layout title="Col·labora">
  <section class="page-intro"><p class="eyebrow">COL·LABORACIÓ</p><h1>Un museu<br /><em>compartit.</em></h1><p class="lead">Accedeix al teu espai per inventariar, revisar i aportar context a la col·lecció. El professorat assigna els permisos de col·laboració.</p></section>
  <section class="account-area" aria-labelledby="access-title">
    <div class="section-heading"><div><p class="eyebrow">ESPAI DE GESTIÓ</p><h2 id="access-title">Accés al projecte</h2></div></div>
    <p class="form-message" data-message role="status" aria-live="polite"></p>
    <div class="config-notice" data-unconfigured hidden><b>El tauler encara no està connectat.</b> Configura les variables públiques de Supabase per activar l’accés; la resta del web continua disponible.</div>
    <div class="auth-grid" data-auth-area>
      <form data-login><h3>Inicia sessió</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="current-password" required /></label><button class="button" type="submit">Entrar <span aria-hidden="true">→</span></button><button class="link-button" type="button" data-show-reset>He oblidat la contrasenya</button></form>
      <form data-signup><h3>Crea un compte</h3><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><fieldset class="role-choice"><legend>Tipus de col·laboració</legend><label><input name="requested_role" type="radio" value="student" required /> Alumnat</label><label><input name="requested_role" type="radio" value="teacher" required /> Professorat</label></fieldset><button class="button" type="submit">Registrar-me <span aria-hidden="true">→</span></button><p class="form-note">Rebràs un correu de confirmació si el projecte el requereix. Aquesta elecció és una sol·licitud: no dona permisos fins que el professorat o l’administració la valide.</p></form>
      <form data-reset hidden><h3>Recupera la contrasenya</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><button class="button" type="submit">Enviar enllaç</button><button class="link-button" type="button" data-hide-reset>Tornar a l’accés</button></form>
      <form data-new-password hidden><h3>Tria una contrasenya nova</h3><label>Contrasenya nova<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><button class="button" type="submit">Actualitzar contrasenya</button></form>
    </div>
    <section class="dashboard" data-dashboard hidden aria-labelledby="dashboard-title">
      <div class="dashboard-header"><div><p class="eyebrow">EL MEU ESPAI</p><h2 id="dashboard-title">Hola, <span data-profile-name></span></h2><p data-profile-summary></p></div><button class="button button-quiet" type="button" data-signout>Tancar sessió</button></div>
      <div class="profile-card"><p class="eyebrow">PERFIL</p><dl><div><dt>Correu</dt><dd data-profile-email></dd></div><div><dt>Rol efectiu</dt><dd data-profile-role></dd></div><div><dt>Sol·licitud</dt><dd data-profile-requested-role></dd></div><div><dt>Estat</dt><dd data-profile-approval></dd></div></dl><p class="form-note">La sol·licitud de col·laboració no concedeix permisos per si mateixa; cal que siga validada.</p></div>
      <div data-student-dashboard hidden>
        <div class="dashboard-section"><div><p class="eyebrow">LES MEUES FITXES</p><h3>Inventari en curs</h3></div><div data-own-objects class="dashboard-list"></div></div>
        <div class="dashboard-section"><p class="eyebrow">NOVA FITXA</p><h3>Crea un esborrany</h3><form class="data-form" data-object-form><div class="form-row"><label>Codi d’inventari<input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" placeholder="MUS-001" required /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" placeholder="Dècada de 1980" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><label>Data de finalització del préstec<input name="loan_due_date" type="date" /></label><p class="form-note">Les fitxes en préstec requereixen dades privades que només gestiona el professorat; demana’ls ajuda abans d’enviar-ne una.</p><button class="button" type="submit">Desar esborrany</button></form></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSA UN CANVI</p><h3>Millora una peça publicada</h3><form class="data-form" data-proposal-form><label>Peça publicada<select name="object_id" data-published-objects required><option value="">Carregant…</option></select></label><label>Assumpte<input name="subject" minlength="4" maxlength="180" required /></label><label>Proposta<textarea name="message" rows="5" minlength="10" maxlength="5000" required></textarea></label><button class="button" type="submit">Enviar proposta</button></form></div>
      </div>
      <div data-pending-dashboard hidden class="config-notice" role="status"><b data-pending-title></b> <span data-pending-message></span></div>
      <div data-teacher-dashboard hidden>
        <div class="dashboard-section"><p class="eyebrow">PERSONES COL·LABORADORES</p><h3>Perfils</h3><div class="dashboard-list" data-teacher-profiles></div></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">NOVA FITXA</p><h3>Afig una peça al catàleg</h3><form class="data-form" data-teacher-object-form><div class="form-row"><label>Codi d’inventari<input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" placeholder="MUS-001" required /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-teacher-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-teacher-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" placeholder="Dècada de 1980" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><p class="form-note">Si és un préstec, desa la fitxa i gestiona després les dades privades del préstec. No s’afegeixen dades de donants ací.</p><fieldset class="role-choice"><legend>Visibilitat inicial</legend><label><input name="status" type="radio" value="draft" checked /> Desar com a esborrany</label><label><input name="status" type="radio" value="published" /> Publicar directament</label></fieldset><button class="button" type="submit">Crear fitxa <span aria-hidden="true">→</span></button></form></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">GESTIÓ DEL CATÀLEG</p><h3>Fitxes recents</h3><p class="form-note">Mostra esborranys, fitxes pendents de revisió i publicades.</p><div class="dashboard-list" data-review-objects></div></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSTES</p><h3>Canvis rebuts</h3><div class="dashboard-list" data-proposals></div></div>
      </div>
    </section>
  </section>
  <section class="collaborate"><article><p class="eyebrow">VISITA</p><h2>Vine als corredors</h2><p>Per a grups externs o visites comentades, escriu-nos amb antelació.</p><a class="text-link" href="mailto:museu.informatica@iesestacio.com">Demanar una visita →</a></article><article><p class="eyebrow">COL·LABORA</p><h2>Comparteix coneixement</h2><p>Busquem memòries d’ús, documentació i experiències professionals.</p><a class="text-link" href={`${import.meta.env.BASE_URL}donacions/`}>Proposar una col·laboració →</a></article><article><p class="eyebrow">PROJECTE</p><h2>Aprendre del que queda</h2><p>Conservar és donar context: preguntar qui ho va dissenyar, qui ho usava i què va fer possible.</p></article></section>
</Layout>

<template data-teacher-edit-template>
  <details class="object-editor"><summary>Editar dades bàsiques</summary><form class="data-form" data-object-edit-form><div class="form-row"><label>Codi d’inventari<input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" required /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" required></select></label><label>Vitrina / armari<select name="cabinet_id"></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><div class="form-row"><label>Període o etiqueta<input name="period_label" maxlength="100" /></label><label>Propietat<select name="ownership"><option value="unknown">Per determinar</option><option value="museum_property">Propietat del museu</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label></div><p class="form-note">Les dades privades de préstecs es gestionen posteriorment.</p><button class="small-button" type="submit">Desar canvis</button></form></details>
</template>

<script>
  import { supabase } from '../lib/supabase';
  type Profile = { id: string; display_name: string; role: 'visitor' | 'student' | 'teacher'; requested_role: 'student' | 'teacher' | null; approval_status: string };
  const administratorEmail = 'f.masdomenech@edu.gva.es';
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const setMessage = (text: string, error = false) => { message.textContent = text; message.classList.toggle('is-error', error); };
  const human = (value: string) => ({ visitor: 'Visitant', student: 'Alumne/a', teacher: 'Professor/a', not_required: 'No cal aprovació', pending: 'Pendent', approved: 'Aprovat', rejected: 'Rebutjat', draft: 'Esborrany', pending_review: 'Pendent de revisió' }[value] || value);
  const authArea = $('[data-auth-area]'), dashboard = $('[data-dashboard]');
  const add = (parent: HTMLElement, tag: string, text: string, className?: string) => { const element = document.createElement(tag); element.textContent = text; if (className) element.className = className; parent.append(element); return element; };
  if (!supabase) { $('[data-unconfigured]').hidden = false; authArea.hidden = true; }
   type CatalogueOption = { id: string; name?: string; code?: string; room?: string; title?: string; inventory_code?: string };
   const selectOptions = (selector: string, rows: CatalogueOption[], label: (row: CatalogueOption) => string, optional = false) => { document.querySelectorAll<HTMLSelectElement>(selector).forEach(select => { select.replaceChildren(new Option(optional ? 'Sense assignar' : 'Tria una opció', '')); rows.forEach(row => select.add(new Option(label(row), row.id))); }); };
  async function loadDashboard(user: { id: string; email?: string }) {
    if (!supabase) return;
    const { data: profile, error } = await supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('id', user.id).single();
    if (error || !profile) { setMessage('No s’ha pogut carregar el perfil. Torna-ho a provar.', true); return; }
    authArea.hidden = true; dashboard.hidden = false;
    const isAdministrator = user.email?.toLowerCase() === administratorEmail;
    $('[data-profile-name]').textContent = profile.display_name; $('[data-profile-email]').textContent = user.email || '—'; $('[data-profile-role]').textContent = human(profile.role); $('[data-profile-requested-role]').textContent = profile.requested_role ? human(profile.requested_role) : 'Sense sol·licitud'; $('[data-profile-approval]').textContent = human(profile.approval_status); $('[data-profile-summary]').textContent = isAdministrator ? 'Administra les sol·licituds de col·laboració i la revisió del catàleg.' : profile.role === 'teacher' ? 'Gestiona les col·laboracions d’alumnat i la revisió del catàleg.' : `Rol: ${human(profile.role)} · ${human(profile.approval_status)}.`;
    const student = profile.role === 'student' && profile.approval_status === 'approved';
    const pendingNotice = $('[data-pending-dashboard]'), pendingTitle = $('[data-pending-title]'), pendingMessage = $('[data-pending-message]');
    const teacherRequest = profile.requested_role === 'teacher';
    const awaitingApproval = profile.approval_status === 'pending' && (profile.role === 'student' || teacherRequest);
    const rejectedTeacherRequest = teacherRequest && profile.approval_status === 'rejected';
    pendingNotice.hidden = !(awaitingApproval || rejectedTeacherRequest);
    if (teacherRequest && profile.approval_status === 'pending') { pendingTitle.textContent = 'Sol·licitud docent pendent.'; pendingMessage.textContent = 'L’administració ha de validar-la abans que tingues permisos de professorat.'; }
    else if (rejectedTeacherRequest) { pendingTitle.textContent = 'Sol·licitud docent rebutjada.'; pendingMessage.textContent = 'El teu compte continua com a visitant i no té permisos de professorat.'; }
    else { pendingTitle.textContent = 'Compte pendent d’aprovació.'; pendingMessage.textContent = 'Un/a professor/a ha de validar el teu perfil abans que pugues crear fitxes i propostes.'; }
     const canManageCatalogue = profile.role === 'teacher';
     $('[data-student-dashboard]').hidden = !student; $('[data-teacher-dashboard]').hidden = !(canManageCatalogue || isAdministrator);
     document.querySelectorAll<HTMLElement>('[data-catalogue-management]').forEach(section => section.hidden = !canManageCatalogue);
     if (student) await loadStudent(user.id); if (canManageCatalogue || isAdministrator) await loadTeacher(isAdministrator, canManageCatalogue);
  }
  async function loadStudent(id: string) {
    if (!supabase) return;
    const [objects, types, cabinets, published] = await Promise.all([
      supabase.from('catalog_objects').select('id, inventory_code, title, status, updated_at').eq('created_by', id).order('updated_at', { ascending: false }),
      supabase.from('object_types').select('id, name').order('name'), supabase.from('cabinets').select('id, code, room').order('code'),
      supabase.from('catalog_objects').select('id, title, inventory_code').eq('status', 'published').order('title')
    ]);
    const list = $('[data-own-objects]'); list.replaceChildren(); if (objects.data?.length) objects.data.forEach(row => { const item = document.createElement('article'); add(item, 'b', row.title); add(item, 'span', `${row.inventory_code} · ${human(row.status)}`); list.append(item); }); else add(list, 'p', 'Encara no has creat cap fitxa.');
     selectOptions('[data-object-types]', types.data || [], row => row.name || ''); selectOptions('[data-cabinets]', cabinets.data || [], row => `${row.code} · ${row.room}`, true); selectOptions('[data-published-objects]', published.data || [], row => `${row.title} (${row.inventory_code})`);
  }
   let teacherTypes: CatalogueOption[] = [], teacherCabinets: CatalogueOption[] = [];
   async function loadTeacher(isAdministrator: boolean, canManageCatalogue: boolean) {
     if (!supabase) return;
     const [profiles, objects, proposals, types, cabinets] = await Promise.all([
       (isAdministrator
         ? supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('approval_status', 'pending').order('created_at', { ascending: false })
         : supabase.from('profiles').select('id, display_name, role, requested_role, approval_status').eq('role', 'student').order('created_at', { ascending: false })),
       canManageCatalogue ? supabase.from('catalog_objects').select('id, inventory_code, title, description, manufacturer, model, object_type_id, cabinet_id, production_year_start, production_year_end, period_label, ownership, status, updated_at').in('status', ['draft', 'pending_review', 'published']).order('updated_at', { ascending: false }).limit(50) : Promise.resolve({ data: [], error: null }),
       supabase.from('change_proposals').select('id, subject, message, status, catalog_objects(title)').order('created_at', { ascending: false }),
       canManageCatalogue ? supabase.from('object_types').select('id, name').order('name') : Promise.resolve({ data: [], error: null }),
       canManageCatalogue ? supabase.from('cabinets').select('id, code, room').order('code') : Promise.resolve({ data: [], error: null })
     ]);
     teacherTypes = types.data || []; teacherCabinets = cabinets.data || [];
     if (canManageCatalogue) { selectOptions('[data-teacher-object-types]', teacherTypes, row => row.name || ''); selectOptions('[data-teacher-cabinets]', teacherCabinets, row => `${row.code} · ${row.room}`, true); }
     renderProfiles(profiles.data || [], isAdministrator); if (canManageCatalogue) renderReviewObjects(objects.data || []); renderProposals(proposals.data || []);
  }
   function renderProfiles(rows: Profile[], isAdministrator: boolean) { const target = $('[data-teacher-profiles]'); target.replaceChildren(); rows.forEach(row => { const item = document.createElement('article'); add(item, 'b', row.display_name); add(item, 'span', `${row.requested_role ? `Sol·licitud: ${human(row.requested_role)} · ` : ''}${human(row.role)} · ${human(row.approval_status)}`); const controls = document.createElement('div'); const pendingStudent = row.role === 'student' && row.approval_status === 'pending'; const pendingTeacher = isAdministrator && row.role === 'visitor' && row.requested_role === 'teacher' && row.approval_status === 'pending'; if (pendingStudent || pendingTeacher) { const approve = add(controls, 'button', 'Aprovar', 'small-button') as HTMLButtonElement; approve.type = 'button'; approve.onclick = () => updateProfile(row.id, pendingTeacher ? { role: 'teacher', approval_status: 'approved' } : { role: 'student', approval_status: 'approved' }); const reject = add(controls, 'button', 'Rebutjar', 'small-button') as HTMLButtonElement; reject.type = 'button'; reject.onclick = () => updateProfile(row.id, pendingTeacher ? { role: 'visitor', approval_status: 'rejected' } : { role: 'student', approval_status: 'rejected' }); } item.append(controls); target.append(item); }); if (!rows.length) add(target, 'p', isAdministrator ? 'No hi ha sol·licituds pendents.' : 'No hi ha perfils d’alumnat.'); }
   function renderReviewObjects(rows: any[]) { const target = $('[data-review-objects]'); target.replaceChildren(); rows.forEach(row => { const item = document.createElement('article'); const heading = document.createElement('div'); add(heading, 'b', row.title); add(heading, 'span', `${row.inventory_code} · ${human(row.status)}`); item.append(heading); const controls = document.createElement('div'); if (row.status !== 'published') { const publish = add(controls, 'button', 'Publicar', 'small-button') as HTMLButtonElement; publish.type = 'button'; publish.onclick = () => updateObjectStatus(row.id, 'published'); } if (row.status === 'published' || row.status === 'pending_review') { const draft = add(controls, 'button', 'Tornar a esborrany', 'small-button') as HTMLButtonElement; draft.type = 'button'; draft.onclick = () => updateObjectStatus(row.id, 'draft'); } const archive = add(controls, 'button', 'Arxivar', 'small-button') as HTMLButtonElement; archive.type = 'button'; archive.onclick = () => updateObjectStatus(row.id, 'archived'); item.append(controls); const fragment = ($('[data-teacher-edit-template]') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment; const form = fragment.querySelector<HTMLFormElement>('[data-object-edit-form]')!; fillObjectForm(form, row); form.addEventListener('submit', event => saveObjectChanges(event, row.id)); item.append(fragment); target.append(item); }); if (!rows.length) add(target, 'p', 'No hi ha fitxes recents per gestionar.'); }
  function renderProposals(rows: any[]) { const target = $('[data-proposals]'); target.replaceChildren(); rows.forEach(row => { const item = document.createElement('article'); add(item, 'b', row.subject); add(item, 'span', `${row.catalog_objects?.title || 'Peça sense vincle'} · ${row.status}`); add(item, 'p', row.message); target.append(item); }); if (!rows.length) add(target, 'p', 'No hi ha propostes obertes.'); }
   const cataloguePayload = (data: FormData) => { const integer = (name: string) => data.get(name) ? Number(data.get(name)) : null; return { inventory_code: String(data.get('inventory_code')).trim().toUpperCase(), title: String(data.get('title')).trim(), description: String(data.get('description')).trim() || null, manufacturer: String(data.get('manufacturer')).trim() || null, model: String(data.get('model')).trim() || null, object_type_id: String(data.get('object_type_id')), cabinet_id: String(data.get('cabinet_id')) || null, production_year_start: integer('production_year_start'), production_year_end: integer('production_year_end'), period_label: String(data.get('period_label')).trim() || null, ownership: String(data.get('ownership')) }; };
   function fillObjectForm(form: HTMLFormElement, row: any) { selectOptionsIn(form, 'object_type_id', teacherTypes, option => option.name || ''); selectOptionsIn(form, 'cabinet_id', teacherCabinets, option => `${option.code} · ${option.room}`, true); (['inventory_code', 'title', 'description', 'manufacturer', 'model', 'object_type_id', 'cabinet_id', 'production_year_start', 'production_year_end', 'period_label', 'ownership'] as const).forEach(name => { const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement; if (field) field.value = row[name] == null ? '' : String(row[name]); }); }
   function selectOptionsIn(form: HTMLFormElement, name: string, rows: CatalogueOption[], label: (row: CatalogueOption) => string, optional = false) { const select = form.elements.namedItem(name) as HTMLSelectElement; select.replaceChildren(new Option(optional ? 'Sense assignar' : 'Tria una opció', '')); rows.forEach(row => select.add(new Option(label(row), row.id))); }
   async function refreshTeacherCatalogue() { const { data: { user } } = await supabase!.auth.getUser(); if (user) await loadTeacher(user.email?.toLowerCase() === administratorEmail, true); }
   async function updateProfile(id: string, changes: Record<string, string>) { if (!supabase) return; const { error } = await supabase.from('profiles').update(changes).eq('id', id); setMessage(error ? `No s’ha pogut actualitzar el perfil: ${error.message}` : 'Perfil actualitzat.', !!error); if (!error) { const { data: { user } } = await supabase.auth.getUser(); if (user) await loadDashboard(user); } }
   async function updateObjectStatus(id: string, status: 'draft' | 'published' | 'archived') { if (!supabase) return; const { error } = await supabase.from('catalog_objects').update({ status }).eq('id', id); setMessage(error ? error.message : `Fitxa ${status === 'published' ? 'publicada' : status === 'draft' ? 'tornada a esborrany' : 'arxivada'}.`, !!error); if (!error) await refreshTeacherCatalogue(); }
   async function saveObjectChanges(event: Event, id: string) { event.preventDefault(); if (!supabase) return; const { error } = await supabase.from('catalog_objects').update(cataloguePayload(new FormData(event.currentTarget as HTMLFormElement))).eq('id', id); setMessage(error ? error.message : 'Dades bàsiques actualitzades.', !!error); if (!error) await refreshTeacherCatalogue(); }
  $('[data-login]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const data = new FormData(event.currentTarget as HTMLFormElement); const { data: result, error } = await supabase.auth.signInWithPassword({ email: String(data.get('email')), password: String(data.get('password')) }); if (error) setMessage(error.message, true); else if (result.user) { setMessage('Sessió iniciada.'); await loadDashboard(result.user); } });
  $('[data-signup]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const data = new FormData(event.currentTarget as HTMLFormElement); const requestedRole = String(data.get('requested_role')); if (requestedRole !== 'student' && requestedRole !== 'teacher') { setMessage('Tria si vols col·laborar com a alumnat o professorat.', true); return; } const { data: result, error } = await supabase.auth.signUp({ email: String(data.get('email')), password: String(data.get('password')), options: { data: { display_name: String(data.get('display_name')), requested_role: requestedRole } } }); if (error) setMessage(error.message, true); else if (result.session && result.user) { setMessage('Compte creat. La teua sol·licitud està pendent de validació.'); await loadDashboard(result.user); } else setMessage('Compte creat. Revisa el correu per confirmar-lo; la sol·licitud requerirà validació.'); });
  $('[data-show-reset]').addEventListener('click', () => { $('[data-login]').hidden = true; $('[data-signup]').hidden = true; $('[data-reset]').hidden = false; }); $('[data-hide-reset]').addEventListener('click', () => { $('[data-login]').hidden = false; $('[data-signup]').hidden = false; $('[data-reset]').hidden = true; });
  $('[data-reset]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const email = String(new FormData(event.currentTarget as HTMLFormElement).get('email')); const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: window.location.href }); setMessage(error ? error.message : 'Si el compte existeix, rebràs un enllaç per restablir la contrasenya.', !!error); });
  $('[data-new-password]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const password = String(new FormData(event.currentTarget as HTMLFormElement).get('password')); const { error } = await supabase.auth.updateUser({ password }); if (error) setMessage(error.message, true); else { setMessage('Contrasenya actualitzada. Ja pots iniciar sessió.'); (event.currentTarget as HTMLFormElement).hidden = true; $('[data-login]').hidden = false; $('[data-signup]').hidden = false; } });
  $('[data-signout]').addEventListener('click', async () => { if (!supabase) return; await supabase.auth.signOut(); dashboard.hidden = true; authArea.hidden = false; setMessage('Sessió tancada.'); });
   $('[data-object-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); if (data.get('ownership') === 'loan') { setMessage('Els préstecs els ha de registrar el professorat perquè inclouen dades privades.', true); return; } const integer = (name: string) => data.get(name) ? Number(data.get(name)) : null; const payload = { inventory_code: String(data.get('inventory_code')).trim().toUpperCase(), title: String(data.get('title')).trim(), description: String(data.get('description')).trim() || null, manufacturer: String(data.get('manufacturer')).trim() || null, model: String(data.get('model')).trim() || null, object_type_id: String(data.get('object_type_id')), cabinet_id: String(data.get('cabinet_id')) || null, production_year_start: integer('production_year_start'), production_year_end: integer('production_year_end'), period_label: String(data.get('period_label')).trim() || null, ownership: String(data.get('ownership')), loan_due_date: null, created_by: user.id, status: 'draft' }; const { error } = await supabase.from('catalog_objects').insert(payload); setMessage(error ? error.message : 'Esborrany desat correctament.', !!error); if (!error) { form.reset(); await loadStudent(user.id); } });
   $('[data-teacher-object-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const status = data.get('status') === 'published' ? 'published' : 'draft'; const { error } = await supabase.from('catalog_objects').insert({ ...cataloguePayload(data), created_by: user.id, status }); setMessage(error ? error.message : status === 'published' ? 'Fitxa publicada correctament.' : 'Esborrany desat correctament.', !!error); if (!error) { form.reset(); await refreshTeacherCatalogue(); } });
  $('[data-proposal-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const data = new FormData(event.currentTarget as HTMLFormElement); const { error } = await supabase.from('change_proposals').insert({ object_id: String(data.get('object_id')), subject: String(data.get('subject')).trim(), message: String(data.get('message')).trim(), submitted_by: user.id, status: 'open' }); setMessage(error ? error.message : 'Proposta enviada. Gràcies per millorar el catàleg.', !!error); if (!error) (event.currentTarget as HTMLFormElement).reset(); });
  if (supabase) { supabase.auth.onAuthStateChange((event) => { if (event === 'PASSWORD_RECOVERY') { authArea.hidden = false; dashboard.hidden = true; $('[data-login]').hidden = true; $('[data-signup]').hidden = true; $('[data-reset]').hidden = true; $('[data-new-password]').hidden = false; setMessage('Indica una contrasenya nova.'); } }); supabase.auth.getSession().then(({ data }) => { if (data.session?.user && !$('[data-new-password]').hidden) return; if (data.session?.user) loadDashboard(data.session.user); }); }
</script>
