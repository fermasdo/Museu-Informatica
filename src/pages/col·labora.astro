    async function uploadPhoto(event: Event, objectId: string, photos: ObjectPhoto[]) {
     event.preventDefault();
     if (!supabase || !activeTeacher) return;
     const form = event.currentTarget as HTMLFormElement;
     const data = new FormData(form);
     const file = data.get('photo');
     const altText = String(data.get('alt_text')).trim();
     const caption = String(data.get('caption')).trim() || null;
     const extension = file instanceof File ? ({ 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' } as Record<string, string>)[file.type] : undefined;
     if (!(file instanceof File) || !extension || file.size > 10 * 1024 * 1024) { setMessage('Selecciona una imatge JPEG, PNG o WebP de menys de 10 MiB.', true); return; }
     if (altText.length < 4 || altText.length > 250) { setMessage('El text alternatiu ha de tindre entre 4 i 250 caràcters.', true); return; }
     const position = photos.reduce((maximum, photo) => Math.max(maximum, photo.position ?? -1), -1) + 1;
     if (position > 100) { setMessage('Aquesta peça ja ha arribat al màxim de 101 fotografies.', true); return; }
     const { data: { user } } = await supabase.auth.getUser();
     if (!user) return;
     const storagePath = `${user.id}/${crypto.randomUUID()}.${extension}`;
     const { error: uploadError } = await supabase.storage.from('catalog-photos').upload(storagePath, file, { contentType: file.type });
     if (uploadError) { setMessage(`No s’ha pogut pujar la fotografia: ${uploadError.message}`, true); return; }
     const { error: metadataError } = await supabase.from('object_photos').insert({ object_id: objectId, storage_path: storagePath, alt_text: altText, caption, position, uploaded_by: user.id });
     if (metadataError) { await supabase.storage.from('catalog-photos').remove([storagePath]); setMessage(`No s’ha pogut desar la fotografia: ${metadataError.message}`, true); return; }
     form.reset(); setMessage('Fotografia pujada correctament.'); await refreshTeacherCatalogue();
    }
