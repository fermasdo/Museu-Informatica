   $('[data-object-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); if (data.get('ownership') === 'loan') { setMessage('Els préstecs els ha de registrar el professorat perquè inclouen dades privades.', true); return; } const integer = (name: string) => data.get(name) ? Number(data.get(name)) : null; const payload = { title: String(data.get('title')).trim(), description: String(data.get('description')).trim() || null, manufacturer: String(data.get('manufacturer')).trim() || null, model: String(data.get('model')).trim() || null, object_type_id: String(data.get('object_type_id')), cabinet_id: String(data.get('cabinet_id')) || null, production_year_start: integer('production_year_start'), production_year_end: integer('production_year_end'), period_label: String(data.get('period_label')).trim() || null, ownership: String(data.get('ownership')), loan_due_date: null, created_by: user.id, status: 'draft' }; const { data: created, error } = await supabase.from('catalog_objects').insert(payload).select('inventory_code').single(); setMessage(error ? error.message : `Esborrany desat amb el codi ${created?.inventory_code}.`, !!error); if (!error) { form.reset(); await loadStudent(user.id); } });
    $('[data-teacher-object-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase || !activeTeacher) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); if (data.get('ownership') === 'loan') { setMessage('No es pot crear un préstec sense les dades privades obligatòries del donant. Mantín la selecció per a gestionar-la en el flux privat.', true); return; } const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const status = data.get('status') === 'published' ? 'published' : 'draft'; const { error } = await supabase.from('catalog_objects').insert({ ...cataloguePayload(data), created_by: user.id, status }); setMessage(error ? error.message : status === 'published' ? 'Fitxa publicada correctament.' : 'Esborrany desat correctament.', !!error); if (!error) { form.reset(); await refreshTeacherCatalogue(); } });
   $('[data-object-type-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase || !activeTeacher) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); const { error } = await supabase.from('object_types').insert({ name: String(data.get('name')).trim(), description: String(data.get('description')).trim() || null }); setMessage(error ? error.message : 'Tipologia desada.', !!error); if (!error) { form.reset(); await refreshTeacherCatalogue(); } });
   $('[data-cabinet-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase || !activeTeacher) return; const form = event.currentTarget as HTMLFormElement, data = new FormData(form); const { error } = await supabase.from('cabinets').insert({ code: String(data.get('code')).trim(), room: String(data.get('room')).trim(), shelf: String(data.get('shelf')).trim() || null, notes: String(data.get('notes')).trim() || null }); setMessage(error ? error.message : 'Armari desat.', !!error); if (!error) { form.reset(); await refreshTeacherCatalogue(); } });
    $('[data-proposal-form]').addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const data = new FormData(event.currentTarget as HTMLFormElement); const { error } = await supabase.from('change_proposals').insert({ object_id: String(data.get('object_id')), subject: String(data.get('subject')).trim(), message: String(data.get('message')).trim(), submitted_by: user.id, status: 'open' }); setMessage(error ? error.message : 'Proposta enviada. Gràcies per millorar el catàleg.', !!error); if (!error) { (event.currentTarget as HTMLFormElement).reset(); await loadStudent(user.id); } });
   document.querySelector<HTMLFormElement>('[data-video-proposal-form]')?.addEventListener('submit', async event => { event.preventDefault(); if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const form = event.currentTarget as HTMLFormElement; const data = new FormData(form); const { error } = await supabase.from('video_proposals').insert({ title: String(data.get('title')).trim(), era: Number(data.get('era')), category: String(data.get('category')), video_url: String(data.get('video_url')).trim(), description: String(data.get('description')).trim() || null, submitted_by: user.id }); setMessage(error ? error.message : 'Anunci enviat. El professorat el revisarà abans de publicar-lo.', !!error); if (!error) form.reset(); });
    const donationForm = document.querySelector<HTMLFormElement>('[data-donation-form]');
    if (donationForm && turnstileSiteKey) { const target = document.createElement('div'); donationForm.insertBefore(target, donationForm.querySelector('button')); const script = document.createElement('script'); script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; script.async = true; script.onload = () => { const turnstile = (window as Window & { turnstile?: { render: (element: HTMLElement, options: { sitekey: string; callback: (token: string) => void; 'expired-callback': () => void }) => void } }).turnstile; turnstile?.render(target, { sitekey: turnstileSiteKey, callback: token => donationCaptchaToken = token, 'expired-callback': () => donationCaptchaToken = '' }); }; document.head.append(script); }
    donationForm?.addEventListener('submit', async event => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const donationMessage = document.querySelector<HTMLElement>('[data-donation-message]'); if (!supabase || !turnstileSiteKey || !donationCaptchaToken) { if (donationMessage) donationMessage.textContent = 'Completa la verificació antiabús abans d’enviar la proposta.'; return; } const data = new FormData(form); if (String(data.get('website')).trim()) { if (donationMessage) donationMessage.textContent = 'Gràcies. Et respondrem prompte.'; form.reset(); return; } const object = String(data.get('object')).trim(), story = String(data.get('story')).trim(); const { data: response, error } = await supabase.functions.invoke('submit-donation', { body: { name: String(data.get('name')).trim(), email: String(data.get('email')).trim(), phone: String(data.get('phone')).trim(), message: `${object}\n\n${story}`, turnstileToken: donationCaptchaToken } }); if (donationMessage) donationMessage.textContent = error || response?.error ? 'No s’ha pogut enviar la proposta. Torna-ho a provar més tard.' : 'Gràcies. Et respondrem prompte.'; if (!error && !response?.error) form.reset(); });
  if (supabase) { supabase.auth.onAuthStateChange((event) => { if (event === 'PASSWORD_RECOVERY') { authArea.hidden = false; dashboard.hidden = true; $('[data-login]').hidden = true; $('[data-signup]').hidden = true; $('[data-reset]').hidden = true; $('[data-new-password]').hidden = false; setMessage('Indica una contrasenya nova.'); } }); supabase.auth.getSession().then(({ data }) => { if (data.session?.user && !$('[data-new-password]').hidden) return; if (data.session?.user) loadDashboard(data.session.user); }); }
</script>
