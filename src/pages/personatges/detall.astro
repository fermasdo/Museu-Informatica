---
import Layout from '../../components/Layout.astro';
import { publicFigures } from '../../data/publicFigures';
---
<Layout title="Fitxa de personatge">
  <section class="detail-page figure-detail" data-figure-detail aria-live="polite">
    <p class="no-print"><a class="back-link" href={`${import.meta.env.BASE_URL}personatges/`}>← Torna als personatges</a></p>
    <p class="form-message no-print" data-message role="status"></p>
    <article class="figure-sheet" data-sheet hidden>
      <header class="figure-sheet-header"><p class="eyebrow">MUSEU D’INFORMÀTICA · FITXA BIOGRÀFICA</p><p class="figure-sheet-code" data-slug></p></header>
      <div class="figure-detail-hero"><div class="figure-portrait" data-portrait aria-hidden="true"></div><div><p class="eyebrow" data-meta></p><h1 data-name></h1><p class="lead" data-summary></p><button class="button no-print" type="button" data-print>Imprimir o desar en PDF <span aria-hidden="true">↗</span></button></div></div>
      <div class="figure-editorial"><section><h2>Trajectòria</h2><div data-biography></div></section><section data-contribution-section><h2>Una aportació clau</h2><div data-contribution></div></section></div>
      <section class="figure-sources" data-sources-section><h2>Fonts i lectura</h2><ol data-sources></ol></section>
      <footer class="figure-sheet-footer"><span>IES l’Estació · Museu d’Informàtica</span><span data-print-date></span></footer>
    </article>
    <section class="fallback-sheets" aria-label="Fitxes públiques de referència">{publicFigures.map((figure) => <article class="figure-sheet fallback-sheet" id={figure.slug}><header class="figure-sheet-header"><p class="eyebrow">MUSEU D’INFORMÀTICA · FITXA BIOGRÀFICA</p><p class="figure-sheet-code">// {figure.slug}</p></header><div class="figure-detail-hero"><div class="figure-portrait" aria-hidden="true">{figure.full_name.split(' ').slice(0, 2).map((name) => name[0]).join('')}</div><div><p class="eyebrow">{figure.field} · {[figure.birth_year, figure.death_year].filter((year) => year !== null).join('–')}</p><h1>{figure.full_name}</h1><p class="lead">{figure.summary}</p></div></div><div class="figure-editorial"><section><h2>Trajectòria</h2><p>{figure.biography}</p></section><section><h2>Una aportació clau</h2><p>{figure.contribution}</p></section></div><section class="figure-sources"><h2>Fonts i lectura</h2><ol>{figure.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>)}</ol></section></article>)}</section>
  </section>
</Layout>
<script>
  import { publicFigures } from '../../data/publicFigures';
  import { supabase } from '../../lib/supabase';
  document.documentElement.classList.add('js');
  type Figure = Record<string, any>;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const slug = new URLSearchParams(location.search).get('slug') || decodeURIComponent(location.hash.slice(1));
  const message = $('[data-message]');
  const value = (item: Figure, ...keys: string[]) => keys.map(key => item[key]).find(item => item !== null && item !== undefined && item !== '') || '';
  const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase() || '??';
  const addText = (target: HTMLElement, text: string) => text.split(/\n\s*\n/).filter(Boolean).forEach(part => { const paragraph = document.createElement('p'); paragraph.textContent = part; target.append(paragraph); });
  function render(item: Figure) {
    const name = String(value(item, 'name', 'full_name', 'title'));
    const scope = String(value(item, 'scope', 'area', 'field'));
    const years = value(item, 'life_dates', 'years') || [value(item, 'birth_year'), value(item, 'death_year')].filter(year => year !== null && year !== '').join('–');
    $('[data-slug]').textContent = `// ${item.slug}`; $('[data-name]').textContent = name; $('[data-meta]').textContent = [scope, years].filter(Boolean).join(' · '); $('[data-summary]').textContent = String(value(item, 'summary', 'excerpt', 'description') || 'Fitxa en procés de documentació.');
    const portrait = $('[data-portrait]'); portrait.replaceChildren(); const imageUrl = String(value(item, 'resolved_image_url', 'image_url', 'image_public_url'));
    if (imageUrl) { const image = document.createElement('img'); image.src = imageUrl; image.alt = String(value(item, 'image_alt')) || `Retrat de ${name}`; image.width = 900; image.height = 1125; image.decoding = 'async'; image.addEventListener('error', () => { portrait.setAttribute('aria-hidden', 'true'); portrait.replaceChildren(document.createTextNode(initials(name))); }); portrait.removeAttribute('aria-hidden'); portrait.append(image); } else { portrait.setAttribute('aria-hidden', 'true'); portrait.textContent = initials(name); }
    const biography = String(value(item, 'biography', 'editorial_content', 'content', 'body') || value(item, 'summary', 'excerpt'));
    const contribution = String(value(item, 'contribution', 'key_contribution'));
    const biographyTarget = $('[data-biography]'); const contributionTarget = $('[data-contribution]'); biographyTarget.replaceChildren(); contributionTarget.replaceChildren(); addText(biographyTarget, biography); addText(contributionTarget, contribution);
    const sources = value(item, 'sources', 'source_lines'); const sourceList = $('[data-sources]'); sourceList.replaceChildren(); if (Array.isArray(sources)) sources.forEach((source: any) => { const line = document.createElement('li'); const link = document.createElement('a'); link.href = String(source.url || ''); link.textContent = String(source.label || source.url || 'Font externa'); link.target = '_blank'; link.rel = 'noreferrer'; line.append(link); sourceList.append(line); });
    $('[data-sources-section]').hidden = !sourceList.childElementCount; $('[data-contribution-section]').hidden = !contribution; $('[data-print-date]').textContent = new Intl.DateTimeFormat('ca-ES', { dateStyle: 'long' }).format(new Date()); $('[data-sheet]').hidden = false;
  }
  const fallback = publicFigures.find((figure) => figure.slug === slug);
  if (!slug) message.textContent = 'Tria un personatge des de l’arxiu.';
  else if (!fallback && !supabase) message.textContent = 'Aquesta fitxa no existeix o encara no és pública.';
  else { if (fallback) render(fallback); if (!supabase) message.textContent = 'S’està mostrant la fitxa de referència mentre l’arxiu no està connectat.'; else { const { data, error } = await supabase.from('public_historical_figures').select('*').eq('slug', slug).maybeSingle(); if (error || !data) { if (fallback) message.textContent = 'S’està mostrant la fitxa de referència mentre l’arxiu no està disponible.'; else message.textContent = 'Aquesta fitxa no existeix o encara no és pública.'; } else { const item = data as Figure; if (item.image_path) { const { data: image } = await supabase.storage.from('historical-figure-images').createSignedUrl(item.image_path, 3600); item.resolved_image_url = image?.signedUrl || ''; } render(item); } } }
  $('[data-print]').addEventListener('click', () => window.print());
</script>
