---
import PrivateLayout from '../components/PrivateLayout.astro';
---
<PrivateLayout title="Edita el perfil" current="profile"><section class="private-page"><p class="eyebrow">COMPTE</p><h1 tabindex="-1">Edita el perfil</h1><p class="form-message" data-profile-message role="status" aria-live="polite"></p><form class="data-form profile-form" data-profile-form hidden><div class="profile-avatar-preview" data-profile-avatar aria-hidden="true">?</div><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Imatge de perfil <input name="avatar" type="file" accept="image/jpeg,image/png,image/webp" /></label><p class="form-note">JPEG, PNG o WebP; màxim 2 MB.</p><label class="check"><input name="remove_avatar" type="checkbox" /> <span>Suprimeix la imatge actual</span></label><button class="button" type="submit">Desar perfil</button></form></section><script>
import { supabase } from '../lib/supabase'; const form=document.querySelector<HTMLFormElement>('[data-profile-form]')!, msg=document.querySelector<HTMLElement>('[data-profile-message]')!, avatar=document.querySelector<HTMLElement>('[data-profile-avatar]')!; const say=(text:string,error=false)=>{msg.textContent=text;msg.classList.toggle('is-error',error)}; const initials=(v:string)=>v.split(/\s+/).filter(Boolean).slice(0,2).map(x=>x[0]).join('').toUpperCase()||'?'; let currentPath:string|null=null; async function load(){if(!supabase)return;const {data:{session}}=await supabase.auth.getSession();if(!session)return;const {data:profile}=await supabase.from('profiles').select('display_name, avatar_path').eq('id',session.user.id).maybeSingle();if(!profile){say('No s’ha pogut carregar el perfil.',true);return}currentPath=profile.avatar_path;form.hidden=false;(form.elements.namedItem('display_name') as HTMLInputElement).value=profile.display_name;avatar.textContent=initials(profile.display_name);if(profile.avatar_path){const {data}=await supabase.storage.from('profile-avatars').createSignedUrl(profile.avatar_path,3600);if(data?.signedUrl){const image=new Image(80,80);image.alt='';image.src=data.signedUrl;image.onload=()=>avatar.replaceChildren(image)}}document.querySelector('h1')?.focus()} form.addEventListener('submit',async e=>{e.preventDefault();if(!supabase||!form.reportValidity())return;const {data:{user}}=await supabase.auth.getUser();if(!user)return;const data=new FormData(form),name=String(data.get('display_name')).trim(),file=data.get('avatar');const ext=file instanceof File?({'image/jpeg':'jpg','image/png':'png','image/webp':'webp'}as Record<string,string>)[file.type]:undefined;if(name.length<2||name.length>100||file instanceof File&&file.size&&(!ext||file.size>2*1024*1024)){say('Revisa el nom i la imatge (JPEG, PNG o WebP, màxim 2 MB).',true);return}let next=currentPath,uploaded:string|null=null;if(file instanceof File&&file.size&&ext){uploaded=`${user.id}/${crypto.randomUUID()}.${ext}`;const {error}=await supabase.storage.from('profile-avatars').upload(uploaded,file,{contentType:file.type});if(error){say('No s’ha pogut pujar la imatge.',true);return}next=uploaded}else if(data.get('remove_avatar')==='on')next=null;const {error}=await supabase.from('profiles').update({display_name:name,avatar_path:next}).eq('id',user.id);if(error){if(uploaded)await supabase.storage.from('profile-avatars').remove([uploaded]);say('No s’ha pogut actualitzar el perfil.',true);return}if(currentPath&&currentPath!==next)await supabase.storage.from('profile-avatars').remove([currentPath]);currentPath=next;say('Perfil actualitzat.');await load()});load();
</script></PrivateLayout>
