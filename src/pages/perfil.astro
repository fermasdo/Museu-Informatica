---
import PrivateLayout from '../components/PrivateLayout.astro';
---
<PrivateLayout title="Edita el perfil" current="profile">
  <section class="private-page">
    <p class="eyebrow">COMPTE</p>
    <h1 tabindex="-1">Edita el perfil</h1>
    <p class="form-message" data-profile-message role="status" aria-live="polite"></p>

    <form class="data-form profile-form" data-profile-form hidden>
      <div class="profile-avatar-preview" data-profile-avatar aria-hidden="true">?</div>
      <label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label>
      <label>Imatge de perfil <input name="avatar" type="file" accept="image/jpeg,image/png,image/webp" /></label>
      <p class="form-note">JPEG, PNG o WebP; màxim 2 MB.</p>
      <button class="button" type="submit">Desar perfil</button>
    </form>
  </section>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.querySelector<HTMLFormElement>('[data-profile-form]')!;
    const message = document.querySelector<HTMLElement>('[data-profile-message]')!;
    const avatar = document.querySelector<HTMLElement>('[data-profile-avatar]')!;
    let currentPath: string | null = null;

    const say = (text: string, error = false) => { message.textContent = text; message.classList.toggle('is-error', error); };
    const initials = (value: string) => value.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '?';
    async function renderAvatar(path: string | null, displayName: string) {
      avatar.replaceChildren();
      avatar.textContent = initials(displayName);
      if (!supabase || !path) return;
      const { data } = await supabase.storage.from('profile-avatars').createSignedUrl(path, 3600);
      if (!data?.signedUrl) return;
      const image = new Image(80, 80);
      image.alt = '';
      image.src = data.signedUrl;
      image.onload = () => avatar.replaceChildren(image);
    }

    async function load() {
      if (!supabase) return;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const { data: profile } = await supabase.from('profiles').select('display_name, avatar_path').eq('id', session.user.id).maybeSingle();
      if (!profile) { say('No s’ha pogut carregar el perfil.', true); return; }
      currentPath = profile.avatar_path;
      form.hidden = false;
      (form.elements.namedItem('display_name') as HTMLInputElement).value = profile.display_name;
      await renderAvatar(profile.avatar_path, profile.display_name);
      document.querySelector('h1')?.focus();
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!supabase || !form.reportValidity()) return;
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      const data = new FormData(form);
      const displayName = String(data.get('display_name')).trim();
      const file = data.get('avatar');
      const extension = file instanceof File ? ({ 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' } as Record<string, string>)[file.type] : undefined;
      if (displayName.length < 2 || displayName.length > 100 || (file instanceof File && file.size && (!extension || file.size > 2 * 1024 * 1024))) {
        say('Revisa el nom i la imatge (JPEG, PNG o WebP, màxim 2 MB).', true);
        return;
      }
      let nextPath = currentPath;
      let uploadedPath: string | null = null;
      if (file instanceof File && file.size && extension) {
        uploadedPath = `${user.id}/${crypto.randomUUID()}.${extension}`;
        const { error } = await supabase.storage.from('profile-avatars').upload(uploadedPath, file, { contentType: file.type, upsert: false });
        if (error) { say('No s’ha pogut pujar la imatge.', true); return; }
        nextPath = uploadedPath;
      }
      const { error } = await supabase.from('profiles').update({ display_name: displayName, avatar_path: nextPath }).eq('id', user.id);
      if (error) {
        if (uploadedPath) await supabase.storage.from('profile-avatars').remove([uploadedPath]);
        say('No s’ha pogut actualitzar el perfil.', true);
        return;
      }
      if (currentPath && currentPath !== nextPath) await supabase.storage.from('profile-avatars').remove([currentPath]);
      currentPath = nextPath;
      await renderAvatar(nextPath, displayName);
      say('Perfil actualitzat.');
    });

    void load();
  </script>
</PrivateLayout>
