---
import Layout from '../components/Layout.astro';
import WeeklyHighlights from '../components/WeeklyHighlights.astro';
---
<Layout title="Museu d’Informàtica" description="Tecnologia amb memòria a l’IES l’Estació d’Ontinyent.">
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">IES L’ESTACIÓ · ONTINYENT</p><h1>La tecnologia té <em>memòria.</em></h1><p class="lead">Màquines, jocs, manuals i idees per llegir el passat tecnològic des del present.</p><div class="actions"><a class="button" href={`${import.meta.env.BASE_URL}cataleg/`}>Explora el catàleg <span aria-hidden="true">→</span></a></div></div>
    <figure class="hero-computer"><svg viewBox="0 0 800 600" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><rect width="800" height="600" fill="#0F1C14"/><g stroke="#B8C5BA" stroke-linejoin="round" stroke-width="10"><path fill="#16271C" d="M192 82h340l38 54v250l-38 42H192l-38-42V136z"/><path fill="#08110C" d="M216 124h292v218H216z"/><path fill="#16271C" d="M268 428h188l26 43H242z"/></g><rect x="235" y="143" width="254" height="180" fill="#08110C" stroke="#9EEA63" stroke-width="4"/><text x="260" y="220" fill="#9EEA63" font-family="monospace" font-size="42">READY</text><g fill="#B8C5BA"><path d="M117 472h371l72 69H149z"/><path d="M584 420h108l24 31v120H560V451z"/></g><g fill="#9EEA63"><rect x="602" y="483" width="72" height="6"/><rect x="602" y="498" width="40" height="6"/></g></svg><figcaption>Terminal preparat per recordar.</figcaption></figure>
  </section>
  <WeeklyHighlights />
  <section class="pathways" aria-label="Continua explorant"><a href={`${import.meta.env.BASE_URL}recorreguts/`}><p class="eyebrow">RECORREGUTS</p><h2>Tria un fil per començar.</h2><span>Veure itineraris →</span></a><a href={`${import.meta.env.BASE_URL}laboratori/`}><p class="eyebrow">LABORATORI</p><h2>Experimenta amb programari històric.</h2><span>Obrir recursos →</span></a></section>
  <section class="participate"><p class="eyebrow">EL MUSEU EL FEM ENTRE TOTES</p><h2>Tens una màquina que encara conta coses?</h2><a class="button" href={`${import.meta.env.BASE_URL}col·labora/#donacions`}>Parlem-ne <span aria-hidden="true">→</span></a></section>
</Layout>
