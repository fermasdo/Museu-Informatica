---
import Layout from '../components/Layout.astro';
import Catalogue from '../components/Catalogue.astro';
---
<Layout title="Museu d’Informàtica" description="Tecnologia amb memòria a l’IES l’Estació d’Ontinyent.">
  <section class="hero"><div class="hero-copy"><p class="eyebrow">IES L’ESTACIÓ · ONTINYENT</p><h1>La tecnologia té <em>memòria.</em></h1><p class="lead">Màquines, jocs, manuals i idees per llegir el passat tecnològic des del present.</p><div class="actions"><a class="button" href={`${import.meta.env.BASE_URL}cataleg/`}>Explora el catàleg <span aria-hidden="true">→</span></a><a class="button button-quiet" href={`${import.meta.env.BASE_URL}visita/`}>Prepara la visita</a></div></div><div class="hero-object" role="img" aria-label="Il·lustració d'un terminal retro amb el missatge READY"><span>READY<br />_</span><i></i><b></b></div></section>
  <Catalogue limit={3} />
  <section class="pathways" aria-label="Continua explorant"><a href={`${import.meta.env.BASE_URL}recorreguts/`}><p class="eyebrow">RECORREGUTS</p><h2>Tria un fil per començar.</h2><span>Veure itineraris →</span></a><a href={`${import.meta.env.BASE_URL}laboratori/`}><p class="eyebrow">LABORATORI</p><h2>Experimenta amb programari històric.</h2><span>Obrir recursos →</span></a></section>
  <section class="participate"><p class="eyebrow">EL MUSEU EL FEM ENTRE TOTES</p><h2>Tens una màquina que encara conta coses?</h2><a class="button" href={`${import.meta.env.BASE_URL}col·labora/#donacions`}>Parlem-ne <span aria-hidden="true">→</span></a></section>
</Layout>
