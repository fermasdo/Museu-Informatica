      async function returnToDraft(event: SubmitEvent, id: string) {
        event.preventDefault();
        if (!supabase || pendingObjectStatusUpdates.has(id)) return;
        const form = event.currentTarget as HTMLFormElement;
        const status = form.querySelector<HTMLElement>('[data-return-form-status]')!;
        const data = new FormData(form);
        const reason = String(data.get('review_reason') || '');
        const tasks = data.getAll('pending_tasks').map(value => String(value).trim()).filter(Boolean);
        const note = String(data.get('note') || '').trim();
        if (!form.reportValidity() || !reason || tasks.length < 1 || tasks.length > 5 || tasks.some(task => task.length > 180) || note.length > 1000) { status.textContent = 'Revisa el motiu i les tasques pendents abans de continuar.'; return; }
        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
        submit.disabled = true; submit.textContent = 'Retornant…'; pendingObjectStatusUpdates.add(id);
        try { const { error } = await supabase.rpc('review_catalog_object', { object_uuid: id, next_status: 'draft', p_review_reason: reason, p_pending_tasks: tasks, note: note || null }); if (error) { status.textContent = 'No s’ha pogut retornar la fitxa. Torna-ho a provar.'; submit.disabled = false; submit.textContent = 'Retornar a esborrany'; setMessage(status.textContent, true); return; } setMessage('Fitxa tornada a esborrany amb indicacions.'); await refreshTeacherCatalogue(); } finally { pendingObjectStatusUpdates.delete(id); objectStatusInvoker = null; }
      }
