---
import FigureManagement from './FigureManagement.astro';
const { mode = 'public' } = Astro.props;
const requestedManagementSection = Astro.url.searchParams.get('section');
const managementSection = ['cataleg', 'usuaris', 'fitxes', 'anuncis'].includes(requestedManagementSection || '') ? requestedManagementSection! : 'cataleg';
const managementHref = (section: string) => `${import.meta.env.BASE_URL}gestio-cataleg/?section=${section}`;
---
<div class={`collaboration-workspace collaboration-workspace--${mode}`} data-workspace-mode={mode}>
  <section class="page-intro"><p class="eyebrow">COL·LABORACIÓ</p><h1>Un museu<br /><em>compartit.</em></h1><p class="lead">Accedeix al teu espai per inventariar, revisar i aportar context a la col·lecció.</p></section>
  <section class="account-area" aria-labelledby="access-title">
    <div class="section-heading"><div><p class="eyebrow">ESPAI DE GESTIÓ</p><h2 id="access-title">Accés al projecte</h2></div></div>
    <p class="form-message" data-message role="status" aria-live="polite"></p>
    <div class="config-notice" data-unconfigured hidden><b>El tauler encara no està connectat.</b> Configura les variables públiques de Supabase per activar l’accés; la resta del web continua disponible.</div>
    <div class="auth-grid" data-auth-area hidden={mode === 'space' || mode === 'manage'}>
      {mode === 'public' && <form id="inicia-sessio" data-login tabindex="-1"><h3>Inicia sessió</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="current-password" required /></label><button class="button" type="submit">Entrar <span aria-hidden="true">→</span></button><button class="link-button" type="button" data-show-reset>He oblidat la contrasenya</button><p class="form-note">No tens compte? <a href={`${import.meta.env.BASE_URL}registre/`}>Crea’n un</a>.</p></form>}
      {mode === 'register' && <form id="crea-compte" data-signup tabindex="-1"><h3>Crea un compte</h3><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><fieldset class="role-choice"><legend>Tipus de col·laboració</legend><label><input name="requested_role" type="radio" value="student" required /> Alumnat</label><label><input name="requested_role" type="radio" value="teacher" required /> Professorat</label></fieldset><button class="button" type="submit">Registrar-me <span aria-hidden="true">→</span></button><p class="form-note">Rebràs un correu de confirmació si el projecte el requereix. Aquesta elecció és una sol·licitud: no dona permisos fins que el professorat o l’administració la valide.</p><p class="form-note">Ja tens compte? <a href={`${import.meta.env.BASE_URL}col·labora/`}>Torna a l’accés</a>.</p></form>}
      {mode === 'public' && <form data-reset hidden><h3>Recupera la contrasenya</h3><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><button class="button" type="submit">Enviar enllaç</button><button class="link-button" type="button" data-hide-reset>Tornar a l’accés</button></form>}
      <form data-new-password hidden><h3>Tria una contrasenya nova</h3><label>Contrasenya nova<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><button class="button" type="submit">Actualitzar contrasenya</button></form>
    </div>
    <section class="dashboard" data-dashboard hidden aria-labelledby={mode === 'manage' ? undefined : 'dashboard-title'}>
      {mode !== 'manage' && <div class="dashboard-header"><div><p class="eyebrow">EL MEU ESPAI</p><h2 id="dashboard-title">Hola, <span data-profile-name></span></h2><p data-profile-summary></p></div><button class="button button-quiet" type="button" data-signout>Tancar sessió</button></div>}
      <div id="perfil" class="profile-card" tabindex="-1"><p class="eyebrow">PERFIL</p><dl><div><dt>Correu</dt><dd data-profile-email></dd></div><div><dt>Rol efectiu</dt><dd data-profile-role></dd></div><div><dt>Sol·licitud</dt><dd data-profile-requested-role></dd></div><div><dt>Estat</dt><dd data-profile-approval></dd></div></dl><form class="data-form profile-form" data-profile-form><div class="profile-avatar-preview" data-profile-avatar aria-hidden="true">?</div><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Imatge de perfil <span class="sr-only">(opcional)</span><input name="avatar" type="file" accept="image/jpeg,image/png,image/webp" /></label><p class="form-note">JPEG, PNG o WebP; màxim 2 MB. Pots canviar-la o suprimir-la quan vulgues.</p><label class="check"><input name="remove_avatar" type="checkbox" /> <span>Suprimeix la imatge actual</span></label><button class="small-button" type="submit">Desar perfil</button></form><p class="form-note">La sol·licitud de col·laboració no concedeix permisos per si mateixa; cal que siga validada.</p></div>
      <div data-student-dashboard hidden>
        <div class="dashboard-section"><div><p class="eyebrow">LES MEUES FITXES</p><h3>Inventari en curs</h3></div><div data-own-objects class="dashboard-list"></div></div>
        <div class="dashboard-section"><p class="eyebrow">NOVA FITXA</p><h3>Crea un esborrany</h3><form class="data-form" data-object-form><p class="form-note">El codi d’inventari s’assigna automàticament en desar.</p><label>Títol<input name="title" minlength="2" maxlength="180" required /></label><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><fieldset class="tag-choice" data-tag-picker><legend>Etiquetes</legend><p class="form-note">Selecciona hashtags existents per descriure la peça.</p><div data-tag-options></div></fieldset><label>Procedència<select name="ownership"><option value="museum_property">Centre</option></select></label><p class="form-note">Les fitxes creades per l’alumnat s’incorporen com a procedents del centre.</p><button class="button" type="submit">Desar esborrany</button></form></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSA UN CANVI</p><h3>Millora una peça publicada</h3><form class="data-form" data-proposal-form><label>Peça publicada<select name="object_id" data-published-objects required><option value="">Carregant…</option></select></label><label>Assumpte<input name="subject" minlength="4" maxlength="180" required /></label><label>Proposta<textarea name="message" rows="5" minlength="10" maxlength="5000" required></textarea></label><button class="button" type="submit">Enviar proposta</button></form><h4>Les meues propostes</h4><div class="dashboard-list" data-own-proposals></div></div>
        <div id="anuncis" class="dashboard-section"><p class="eyebrow">ARXIU AUDIOVISUAL</p><h3>Proposa un anunci</h3><form class="data-form" data-video-proposal-form><label>Títol<input name="title" minlength="4" maxlength="180" required /></label><div class="form-row"><label>Any<input name="era" type="number" min="1800" max="2200" required /></label><label>Tipologia<select name="category"><option>Ordinador personal</option><option>Consola</option><option>Videojoc</option><option>Programari</option></select></label></div><label>Enllaç de YouTube<input name="video_url" type="url" placeholder="https://www.youtube.com/…" required /></label><label>Context <span class="sr-only">(opcional)</span><textarea name="description" rows="3" maxlength="2000"></textarea></label><button class="button" type="submit">Enviar per revisar</button></form></div>
      </div>
      <div data-pending-dashboard hidden class="config-notice" role="status"><b data-pending-title></b> <span data-pending-message></span></div>
      <div data-teacher-dashboard hidden>
        <section class="dashboard-summary" aria-labelledby="admin-summary-title">
          <div class="dashboard-summary-heading"><div><p class="eyebrow" data-teacher-summary-label>GESTIÓ</p><h3 id="admin-summary-title">Resum administratiu</h3></div><p>Accés ràpid a les tasques que requereixen atenció.</p></div>
          <div class="dashboard-summary-grid">
            <a class="summary-card" href={`${managementHref('cataleg')}&status=pending_review`}><span>Fitxes pendents</span><strong data-summary-count="pending_review">Carregant…</strong><small>Obri la gestió de fitxes pendents</small></a>
            <a class="summary-card" href={mode === 'space' ? '#gestio-donacions' : `${managementHref('cataleg')}&donations=open`} data-summary-donation-filter={mode === 'space' ? 'open' : undefined}><span>Donacions obertes</span><strong data-summary-count="donations">Carregant…</strong><small>Filtra les propostes noves i contactades</small></a>
            <a class="summary-card" href={mode === 'space' ? '#gestio-perfils' : `${managementHref('usuaris')}&profile=pending`} data-summary-profile-filter={mode === 'space' ? 'pending' : undefined}><span data-summary-users-label>Usuaris pendents</span><strong data-summary-count="profiles">Carregant…</strong><small>Filtra els perfils pendents d’aprovació</small></a>
            <a class="summary-card" href={`${managementHref('cataleg')}&status=archived`}><span>Fitxes arxivades</span><strong data-summary-count="archived">Carregant…</strong><small>Obri la gestió de fitxes arxivades</small></a>
          </div>
          <p class="sr-only" data-summary-status role="status" aria-live="polite"></p>
        </section>
        {mode === 'manage' && <nav class="management-sections" aria-label="Seccions de gestió"><a href={managementHref('cataleg')} aria-current={managementSection === 'cataleg' ? 'page' : undefined}>Catàleg</a><a href={managementHref('usuaris')} aria-current={managementSection === 'usuaris' ? 'page' : undefined}>Usuaris</a><a href={managementHref('fitxes')} aria-current={managementSection === 'fitxes' ? 'page' : undefined}>Fitxes (personatges)</a><a href={managementHref('anuncis')} aria-current={managementSection === 'anuncis' ? 'page' : undefined}>Anuncis</a></nav>}
        <div data-management-section="usuaris" hidden={mode === 'manage' && managementSection !== 'usuaris'}><div id="gestio-perfils" class="dashboard-section" tabindex="-1"><p class="eyebrow">PERSONES COL·LABORADORES</p><h3>Perfils</h3><label>Filtra els perfils<select data-profile-filter><option value="">Tots els perfils</option><option value="pending">Pendents d’aprovació</option></select></label><div class="dashboard-list" data-teacher-profiles></div></div></div>
        <div data-management-section="cataleg" hidden={mode === 'manage' && managementSection !== 'cataleg'}>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">NOVA FITXA</p><h3>Afig una peça al catàleg</h3><form class="data-form" data-teacher-object-form><div class="form-row"><label>Codi d’inventari <span class="sr-only">(opcional)</span><input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" placeholder="Automàtic si el deixes buit" aria-describedby="inventory-help" /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><p id="inventory-help" class="form-note">Opcional: si no l’indiques, se n’assignarà un automàticament.</p><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" data-teacher-object-types required><option value="">Carregant…</option></select></label><label>Vitrina / armari<select name="cabinet_id" data-teacher-cabinets><option value="">Sense assignar</option></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><fieldset class="tag-choice" data-tag-picker><legend>Etiquetes</legend><p class="form-note">Selecciona hashtags existents per descriure la peça.</p><div data-tag-options></div></fieldset><label>Procedència<select name="ownership" data-provenance-select><option value="museum_property">Centre</option><option value="donation">Donació</option><option value="loan">Préstec</option></select></label><fieldset data-contact-fieldset hidden><legend>Persona vinculada</legend><label><span data-contact-label>Persona donant</span><input name="contact_name" data-contact-name maxlength="180" /></label><p class="form-note">Aquesta dada és privada i només s’utilitza per gestionar la procedència de la peça.</p><p class="form-note" data-contact-status role="status" aria-live="polite"></p></fieldset><button class="button" type="submit">Crear fitxa <span aria-hidden="true">→</span></button></form></div>
        <div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">TAXONOMIES I UBICACIONS</p><h3>Prepara el catàleg</h3><div class="catalogue-settings-grid"><div><h4>Tipologies</h4><form class="data-form" data-object-type-form><label>Nom<input name="name" minlength="2" maxlength="80" required /></label><label>Descripció <span class="sr-only">(opcional)</span><textarea name="description" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Afegir tipologia</button></form><div class="dashboard-list" data-object-types-list></div></div><div><h4>Etiquetes</h4><form class="data-form" data-tag-form><label>Etiqueta<input name="name" minlength="2" maxlength="60" required placeholder="Ex.: retroinformàtica" /></label><p class="form-note">Es normalitzarà i es mostrarà com a hashtag.</p><button class="small-button" type="submit">Afegir etiqueta</button></form><div class="dashboard-list" data-tags-list></div></div><div><h4>Ubicacions</h4><form class="data-form" data-cabinet-form><div class="form-row"><label>Codi<input name="code" pattern="[A-Za-z0-9_-]{1,30}" required /></label><label>Edifici<select name="building" required><option value="">Tria un edifici</option><option value="Cicles">Cicles</option><option value="ESO">ESO</option><option value="Administració">Administració</option></select></label></div><label>Armari<input name="cabinet" maxlength="80" required /></label><label>Prestatge <span class="sr-only">(opcional)</span><input name="shelf" maxlength="40" /></label><label>Notes <span class="sr-only">(opcional)</span><textarea name="notes" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Afegir ubicació</button></form><div class="dashboard-list" data-cabinets-list></div></div></div></div>
        <div id="gestio-cataleg" class="dashboard-section" data-catalogue-management hidden tabindex="-1"><p class="eyebrow">GESTIÓ DEL CATÀLEG</p><h3>Revisa, edita i publica fitxes</h3><p class="form-note">Tota fitxa nova comença com a esborrany. Ací pots usar <b>Editar</b> per completar-la i <b>Publicar</b> quan estiga preparada.</p><form class="data-form" data-review-search><label>Cerca per títol, codi, fabricant o model<input name="q" type="search" autocomplete="off" /></label><div class="form-row"><label>Filtra per estat<select name="status" data-review-filter><option value="">Totes</option><option value="pending_review">Pendents de revisió</option><option value="draft">Esborranys</option><option value="published">Publicades</option><option value="archived">Arxivades</option></select></label><label>Filtra per tipologia<select name="type" data-review-type-filter><option value="">Totes les tipologies</option></select></label></div><div><button class="small-button" type="submit">Aplicar cerca i filtres</button><button class="link-button" type="reset">Restablir</button></div></form><p class="form-note" data-review-summary role="status" aria-live="polite"></p><p class="sr-only" data-bulk-status role="status" aria-live="polite"></p><section class="bulk-actions" data-bulk-actions hidden aria-label="Accions sobre les fitxes seleccionades"><p><strong data-bulk-count>0</strong> <span data-bulk-count-label>fitxes seleccionades</span></p><div><button class="link-button" type="button" data-bulk-clear data-bulk-control>Netejar</button><button class="small-button" type="button" data-bulk-publish data-bulk-control>Publicar</button><button class="small-button" type="button" data-bulk-archive data-bulk-control>Arxivar</button><button class="small-button" type="button" data-bulk-tag data-bulk-control>Afegir etiqueta</button></div></section><div class="review-selection-control" data-review-selection-control hidden><label><input type="checkbox" data-review-select-page aria-label="Selecciona totes les fitxes carregades en aquesta pàgina" /> Selecciona les fitxes carregades</label></div><div class="dashboard-list" data-review-objects></div><nav data-review-pagination aria-label="Paginació de fitxes" hidden></nav></div>
        <div class="dashboard-section"><p class="eyebrow">PROPOSTES</p><h3>Canvis rebuts</h3><div class="dashboard-list" data-proposals></div></div>
        <div id="gestio-donacions" class="dashboard-section" data-catalogue-management hidden tabindex="-1"><p class="eyebrow">DONACIONS</p><h3>Propostes de donació</h3><label>Filtra les donacions<select data-donation-filter><option value="">Totes les donacions</option><option value="open">Obertes: noves i contactades</option></select></label><div class="dashboard-list" data-donation-contacts></div></div>
        </div>
        <div data-management-section="anuncis" hidden={mode === 'manage' && managementSection !== 'anuncis'}><div class="dashboard-section" data-catalogue-management hidden><p class="eyebrow">ANUNCIS PROPOSATS</p><h3>Revisa l’arxiu audiovisual</h3><div class="dashboard-list" data-video-proposals></div></div></div>
        <div data-management-section="fitxes" hidden={mode === 'manage' && managementSection !== 'fitxes'}><FigureManagement /></div>
       </div>
    </section>
  </section>
  <section class="collaborate"><article><p class="eyebrow">COL·LABORA</p><h2>Comparteix coneixement</h2><p>Busquem memòries d’ús, documentació i experiències professionals.</p><a class="text-link" href="#donacions">Proposar una col·laboració →</a></article><article><p class="eyebrow">PROJECTE</p><h2>Aprendre del que queda</h2><p>Conservar és donar context: preguntar qui ho va dissenyar, qui ho usava i què va fer possible.</p></article></section>
  <section id="donacions" class="form-layout"><div><p class="eyebrow">CUSTODIAR, NO ACUMULAR</p><h2>Dona una <em>història.</em></h2><p class="lead">Abans de desfer-te d’un ordinador, consola, perifèric o manual, conta’ns què és i d’on ve.</p><p>Revisarem cada proposta amb cura. No tot entrarà a la col·lecció, però tota memòria ens ajuda a documentar-la millor.</p></div><form data-donation-form><div class="form-row"><label>Nom i cognoms<input name="name" autocomplete="name" required /></label><label>Correu electrònic<input type="email" name="email" autocomplete="email" required /></label></div><label>Telèfon <span class="sr-only">(opcional)</span><input name="phone" autocomplete="tel" /></label><label>Quin objecte vols proposar?<input name="object" required placeholder="Ex.: ordinador, joc, manual…" /></label><label>La seua història<textarea name="story" rows="5" required placeholder="Marca, any aproximat, estat, com va arribar a tu…"></textarea></label><label class="sr-only" aria-hidden="true">No emplenes aquest camp<input name="website" tabindex="-1" autocomplete="off" /></label><label class="check"><input name="consent" type="checkbox" required /> <span>Accepte que em contacten sobre aquesta proposta.</span></label><p class="form-note">Guardem el consentiment per gestionar aquesta proposta, versió 2026-10.</p><button class="button" type="submit">Enviar proposta <span aria-hidden="true">→</span></button><p class="form-note" data-donation-message aria-live="polite"></p></form></section>
</div>

<template data-teacher-edit-template>
  <details class="object-editor"><summary>Editar dades i enllaços</summary><form class="data-form" data-object-edit-form><div class="form-row"><label>Codi d’inventari <span class="sr-only">(opcional)</span><input name="inventory_code" pattern="[A-Z0-9][A-Z0-9_-]{2,39}" /></label><label>Títol<input name="title" minlength="2" maxlength="180" required /></label></div><label>Descripció<textarea name="description" rows="4"></textarea></label><div class="form-row"><label>Fabricant<input name="manufacturer" maxlength="120" /></label><label>Model<input name="model" maxlength="120" /></label></div><div class="form-row"><label>Tipologia<select name="object_type_id" required></select></label><label>Vitrina / armari<select name="cabinet_id"></select></label></div><div class="form-row"><label>Any inicial<input name="production_year_start" type="number" min="1800" max="2200" /></label><label>Any final<input name="production_year_end" type="number" min="1800" max="2200" /></label></div><fieldset class="tag-choice" data-tag-picker><legend>Etiquetes</legend><div data-tag-options></div></fieldset><label>Procedència<select name="ownership" data-provenance-select required><option value="museum_property">Centre</option><option value="donation">Donació</option><option value="loan">Préstec</option><option value="unknown" disabled>Procedència antiga desconeguda — tria una opció</option></select></label><fieldset data-contact-fieldset hidden><legend>Persona vinculada</legend><label><span data-contact-label>Persona donant</span><input name="contact_name" data-contact-name minlength="2" maxlength="150" aria-describedby="contact-name-help" /></label><p id="contact-name-help" class="form-note">Indica el nom complet de la persona vinculada, entre 2 i 150 caràcters. Aquesta dada és privada i només s’utilitza per gestionar la procedència de la peça.</p><p class="form-note" data-contact-status role="status" aria-live="polite"></p></fieldset><label>Enllaç a més informació<input name="information_url" type="url" placeholder="https://…" /></label><label>Vídeo relacionat<input name="video_url" type="url" placeholder="https://…" /></label><button class="small-button" type="submit">Desar canvis</button></form></details>
</template>

<template data-photo-manager-template>
  <details class="object-editor photo-manager"><summary>Gestionar fotografies</summary><div class="photo-manager-content"><form class="data-form" data-photo-form><label>Fitxer (JPEG, PNG o WebP; màxim 10 MiB)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required /></label><label>Text alternatiu<input name="alt_text" minlength="4" maxlength="250" required /></label><label>Peu de foto <span class="sr-only">(opcional)</span><textarea name="caption" rows="2" maxlength="500"></textarea></label><button class="small-button" type="submit">Pujar fotografia</button></form><div class="photo-list" data-photo-list></div></div></details>
</template>

  <template data-return-to-draft-template>
  <section class="return-to-draft-panel" data-return-to-draft-panel aria-labelledby="return-to-draft-title">
    <h4 id="return-to-draft-title">Retorna la fitxa amb indicacions</h4>
    <p class="form-note">Indica què ha de revisar l’alumnat abans de tornar a enviar la fitxa.</p>
    <form class="data-form" data-return-to-draft-form>
      <label>Motiu principal<select name="review_reason" required><option value="">Tria un motiu</option><option value="incomplete_data">Informació incompleta</option><option value="verify_information">Cal verificar la informació</option><option value="missing_context">Falta context o fonts</option><option value="photo_feedback">Fotografies o text alternatiu per completar</option><option value="classification_or_location">Classificació o ubicació per revisar</option><option value="other">Un altre motiu</option></select></label>
      <fieldset data-pending-tasks><legend>Tasques pendents</legend><p class="form-note">Afig entre una i cinc tasques concretes, de fins a 180 caràcters cadascuna.</p><div data-pending-task-list></div><button class="link-button" type="button" data-add-pending-task>Afegir una tasca</button></fieldset>
      <label>Aclariment per a l’alumnat <span class="sr-only">(opcional)</span><textarea name="note" rows="3" maxlength="1000" aria-describedby="return-note-help"></textarea></label>
      <p id="return-note-help" class="form-note">Opcional, màxim 1.000 caràcters.</p>
