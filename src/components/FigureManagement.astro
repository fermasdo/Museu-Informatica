<section class="figure-management dashboard-section" data-figure-management hidden aria-labelledby="figure-management-title">
  <p class="eyebrow">PERSONATGES</p><h3 id="figure-management-title">Fitxes biogràfiques</h3>
  <p class="form-note">Crea, completa i publica les fitxes de personatges. La imatge es podrà vincular des del bucket en una iteració posterior.</p>
  <p class="form-message" data-figure-management-message role="status" aria-live="polite"></p>
  <form class="data-form figure-form" data-figure-form>
    <input type="hidden" name="id" />
    <div class="form-row"><label>Nom complet<input name="full_name" minlength="2" maxlength="180" required /></label><label>Slug<input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="120" required aria-describedby="figure-slug-help" /></label></div>
    <p id="figure-slug-help" class="form-note">Minúscules, nombres i guions. Ex.: ada-lovelace.</p>
    <div class="form-row"><label>Àmbit<input name="field" minlength="2" maxlength="120" required placeholder="Ex.: Programació" /></label><label>Estat<select name="status"><option value="draft">Esborrany</option><option value="published">Publicada</option><option value="archived">Arxivada</option></select></label></div>
    <div class="form-row"><label>Any de naixement <span class="sr-only">(opcional)</span><input name="birth_year" type="number" min="-5000" max="2100" /></label><label>Any de defunció <span class="sr-only">(opcional)</span><input name="death_year" type="number" min="-5000" max="2100" /></label></div>
    <label>Resum<input name="summary" minlength="20" maxlength="600" required /></label>
    <label>Trajectòria<textarea name="biography" rows="6" minlength="20" required></textarea></label>
    <label>Aportació clau<textarea name="contribution" rows="4" minlength="10" required></textarea></label>
    <label>Fet destacat <span class="sr-only">(opcional)</span><textarea name="notable_fact" rows="2" maxlength="1000"></textarea></label>
    <fieldset class="figure-sources-editor"><legend>Fonts</legend><p class="form-note">Una font per línia, amb etiqueta i URL separades per una barra vertical. Ex.: Museu de la Ciència | https://exemple.org</p><label class="sr-only">Fonts, una per línia</label><textarea name="sources" rows="4" required placeholder="Enciclopèdia Britannica | https://www.britannica.com/"></textarea></fieldset>
    <p class="form-note">La vinculació d’una imatge des del bucket s’afegirà en una iteració posterior. Mentrestant, les fitxes sense imatge es mostren amb inicials tipogràfiques.</p>
    <div><button class="small-button" type="submit" data-figure-save>Desar fitxa</button><button class="link-button" type="button" data-figure-cancel hidden>Cancel·lar edició</button></div>
  </form>
  <div class="dashboard-list" data-figure-list></div>
</section>
<script>
  import { supabase } from '../lib/supabase';
  type Figure = Record<string, any>;
  const section = document.querySelector<HTMLElement>('[data-figure-management]')!;
  const form = document.querySelector<HTMLFormElement>('[data-figure-form]')!;
  const list = document.querySelector<HTMLElement>('[data-figure-list]')!;
  const message = document.querySelector<HTMLElement>('[data-figure-management-message]')!;
  const cancel = document.querySelector<HTMLButtonElement>('[data-figure-cancel]')!;
  const setMessage = (text: string, error = false) => { message.textContent = text; message.classList.toggle('is-error', error); };
   const sourceError = (value: string) => { const lines = value.split('\n').map(line => line.trim()).filter(Boolean); if (lines.length < 1 || lines.length > 8) return 'Indica entre 1 i 8 fonts, una per línia.'; for (const line of lines) { const parts = line.split('|').map(part => part.trim()); const [label, url] = parts; if (parts.length !== 2 || !label || label.length < 2 || label.length > 200 || !url || url.length < 9 || url.length > 2048 || !/^https:\/\/[^\s]+$/i.test(url)) return 'Cada font ha de tindre una etiqueta de 2 a 200 caràcters i una URL HTTPS vàlida, separades per una barra vertical.'; } return ''; };
   const parseSources = (value: string) => { const error = sourceError(value); if (error) throw new Error(error); return value.split('\n').map(line => line.trim()).filter(Boolean).map(line => { const [label, url] = line.split('|').map(part => part.trim()); return { label, url }; }); };
  const sourcesText = (sources: unknown) => Array.isArray(sources) ? sources.map((source: any) => `${source.label || source.url} | ${source.url}`).join('\n') : '';
  function reset() { form.reset(); (form.elements.namedItem('id') as HTMLInputElement).value = ''; cancel.hidden = true; }
  function edit(item: Figure) { (['id', 'full_name', 'slug', 'field', 'status', 'birth_year', 'death_year', 'summary', 'biography', 'contribution', 'notable_fact'] as const).forEach(key => { const input = form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement; if (input) input.value = item[key] ?? ''; }); (form.elements.namedItem('sources') as HTMLTextAreaElement).value = sourcesText(item.sources); cancel.hidden = false; form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); (form.elements.namedItem('full_name') as HTMLInputElement).focus({ preventScroll: true }); }
  async function load() { if (!supabase) return; const { data, error } = await supabase.from('historical_figures').select('*').order('updated_at', { ascending: false }); list.replaceChildren(); if (error) { setMessage('No s’han pogut carregar les fitxes de personatges.', true); return; } if (!data?.length) { list.textContent = 'Encara no hi ha fitxes creades.'; return; } data.forEach((item: Figure) => { const article = document.createElement('article'); const text = document.createElement('div'); const name = document.createElement('b'); name.textContent = item.full_name; const meta = document.createElement('span'); meta.textContent = `${item.field} · ${item.status}`; text.append(name, meta); const controls = document.createElement('div'); const button = document.createElement('button'); button.type = 'button'; button.className = 'small-button'; button.textContent = 'Editar'; button.onclick = () => edit(item); controls.append(button); article.append(text, controls); list.append(article); }); }
  async function initialise() { if (!supabase) return; const { data: { user } } = await supabase.auth.getUser(); if (!user) return; const [{ data: profile }, { data: administrator }] = await Promise.all([supabase.from('profiles').select('role').eq('id', user.id).maybeSingle(), supabase.rpc('is_administrator')]); if (profile?.role !== 'teacher' && administrator !== true) return; section.hidden = false; await load(); }
   const sourcesInput = form.elements.namedItem('sources') as HTMLTextAreaElement; const birthYear = form.elements.namedItem('birth_year') as HTMLInputElement; const deathYear = form.elements.namedItem('death_year') as HTMLInputElement;
   function validateClient() { const sourcesError = sourceError(sourcesInput.value); sourcesInput.setCustomValidity(sourcesError); const birth = birthYear.value === '' ? null : Number(birthYear.value); const death = deathYear.value === '' ? null : Number(deathYear.value); deathYear.setCustomValidity(birth !== null && death !== null && death < birth ? 'L’any de defunció no pot ser anterior al de naixement.' : ''); }
   sourcesInput.addEventListener('input', validateClient); birthYear.addEventListener('input', validateClient); deathYear.addEventListener('input', validateClient);
   form.addEventListener('submit', async event => { event.preventDefault(); validateClient(); if (!supabase || !form.reportValidity()) return; try { const data = new FormData(form); const year = (name: string) => { const input = String(data.get(name) || '').trim(); return input === '' ? null : Number(input); }; const payload = { full_name: String(data.get('full_name')).trim(), slug: String(data.get('slug')).trim(), field: String(data.get('field')).trim(), status: String(data.get('status')), birth_year: year('birth_year'), death_year: year('death_year'), summary: String(data.get('summary')).trim(), biography: String(data.get('biography')).trim(), contribution: String(data.get('contribution')).trim(), notable_fact: String(data.get('notable_fact')).trim() || null, sources: parseSources(String(data.get('sources'))) }; const id = String(data.get('id') || ''); const { error } = id ? await supabase.from('historical_figures').update(payload).eq('id', id) : await supabase.from('historical_figures').insert(payload); if (error) { setMessage('No s’ha pogut desar la fitxa. Revisa les dades i torna-ho a provar.', true); return; } setMessage(id ? 'Fitxa actualitzada.' : 'Fitxa creada.'); reset(); await load(); } catch (error) { setMessage(error instanceof Error && error.message.startsWith('Cada font') ? error.message : 'No s’ha pogut desar la fitxa. Revisa les dades i torna-ho a provar.', true); } });
  cancel.addEventListener('click', reset); void initialise();
</script>
