---
import { pieces } from '../data/pieces';
import PieceCard from './PieceCard.astro';
const { limit } = Astro.props as { limit?: number };
const shown = limit ? pieces.slice(0, limit) : pieces;
---
<section class="catalogue" aria-labelledby="catalogue-title">
  <div class="section-heading"><div><p class="eyebrow">COL·LECCIÓ</p><h2 id="catalogue-title">{limit ? 'Una selecció per començar' : 'Explora les peces'}</h2></div></div>
  {!limit && <div class="catalogue-tools"><label class="search-field" for="catalogue-search">Cerca al catàleg<input id="catalogue-search" type="search" placeholder="Nom, fabricant, any o etiqueta" data-search /></label><details class="filter-panel" open data-filter-panel><summary>Filtra i ordena</summary><div class="filters" aria-label="Filtres del catàleg"><label>Dècada<select data-filter="decade"><option value="">Totes</option><option value="1960">1960</option><option value="1980">1980</option><option value="1990">1990</option><option value="2000">2000</option></select></label><label>Tipologia<select data-filter="type"><option value="">Totes</option></select></label><label>Ubicació<select data-filter="location"><option value="">Totes</option></select></label><fieldset class="tag-filters"><legend>Etiquetes</legend><div data-tag-options></div></fieldset><button class="filter-reset" type="button" data-filter-reset>Reinicia els filtres</button></div></details></div>}
  <p class="result-count" data-count aria-live="polite"></p>
  <p class="config-notice" data-catalogue-notice role="status" hidden></p>
  <div class="pieces-grid" data-pieces-grid data-limit={limit ?? ''}>{shown.map(piece => <PieceCard {piece} />)}</div>
  <p class="empty-results" data-empty hidden>No hem trobat cap peça amb aquests criteris. Prova de llevar algun filtre.</p>
  {limit && <a class="text-link" href={`${import.meta.env.BASE_URL}cataleg/`}>Veure les {pieces.length} peces de mostra <span aria-hidden="true">→</span></a>}
</section>
<script>
  import { supabase } from '../lib/supabase';
  type Tag = { name: string; normalized_name: string };
  type RemotePiece = { id: string; title: string; description: string | null; manufacturer: string | null; model: string | null; production_year_start: number | null; period_label: string | null; object_types: { name: string } | null; cabinets: { building: string } | null; object_tags: { tags: Tag | null }[] | null };
  type RemotePhoto = { object_id: string; storage_path: string; alt_text: string | null };
  const grid = document.querySelector<HTMLElement>('[data-pieces-grid]'); const search = document.querySelector<HTMLInputElement>('[data-search]'); const filters = [...document.querySelectorAll<HTMLSelectElement>('[data-filter]')]; const count = document.querySelector<HTMLElement>('[data-count]'); const empty = document.querySelector<HTMLElement>('[data-empty]'); const notice = document.querySelector<HTMLElement>('[data-catalogue-notice]');
  const normalise = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('ca');
  const detailHref = (id: string) => { const params = new URLSearchParams(window.location.search); params.set('id', id); return `${import.meta.env.BASE_URL}cataleg/detall/?${params}`; };
  function tagOptions() { const target = document.querySelector<HTMLElement>('[data-tag-options]'); if (!target || target.childElementCount) return; const all = new Set([...document.querySelectorAll<HTMLElement>('[data-piece]')].flatMap(card => (card.dataset.tags || '').split('|').filter(Boolean))); [...all].sort().forEach(tag => { const label = document.createElement('label'), input = document.createElement('input'); input.type = 'checkbox'; input.value = tag; input.dataset.tagFilter = ''; label.append(input, document.createTextNode(`#${tag}`)); target.append(label); }); }
  function updateUrl() { if (!search) return; const params = new URLSearchParams(); if (search.value) params.set('q', search.value); filters.forEach(filter => { if (filter.value) params.set(filter.dataset.filter!, filter.value); }); const tags = [...document.querySelectorAll<HTMLInputElement>('[data-tag-filter]:checked')].map(input => input.value); if (tags.length) params.set('tags', tags.join(',')); history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`); document.querySelectorAll<HTMLAnchorElement>('[data-detail-link]').forEach(link => { const id = new URL(link.href).searchParams.get('id'); if (id) link.href = detailHref(id); }); }
  function update() { const term = normalise(search?.value || ''); const checkedTags = [...document.querySelectorAll<HTMLInputElement>('[data-tag-filter]:checked')].map(input => normalise(input.value)); let visible = 0; document.querySelectorAll<HTMLElement>('[data-piece]').forEach(card => { const words = normalise(card.dataset.searchText || card.textContent || ''); const matchesText = !term || words.includes(term); const matchesFilters = filters.every(filter => !filter.value || normalise(card.dataset[filter.dataset.filter!] || '') === normalise(filter.value)); const tags = normalise(card.dataset.tags || '').split('|'); const matchesTags = checkedTags.every(tag => tags.includes(tag)); card.hidden = !(matchesText && matchesFilters && matchesTags); if (!card.hidden) visible++; }); if (count) count.textContent = `${visible} ${visible === 1 ? 'peça trobada' : 'peces trobades'}`; if (empty) empty.hidden = visible !== 0; updateUrl(); }
  function restore() { const params = new URLSearchParams(location.search); if (search) search.value = params.get('q') || ''; filters.forEach(filter => filter.value = params.get(filter.dataset.filter!) || ''); const tags = (params.get('tags') || '').split(','); document.querySelectorAll<HTMLInputElement>('[data-tag-filter]').forEach(input => input.checked = tags.includes(input.value)); }
  function hydrateControls() { const cards = [...document.querySelectorAll<HTMLElement>('[data-piece]')], options = { type: new Set(cards.map(card => card.dataset.type).filter(Boolean)), location: new Set(cards.map(card => card.dataset.location).filter(Boolean)) }; Object.entries(options).forEach(([key, values]) => { const select = document.querySelector<HTMLSelectElement>(`[data-filter="${key}"]`); values.forEach(value => { if (select && value && ![...select.options].some(option => option.value === value)) select.add(new Option(value, value)); }); }); tagOptions(); restore(); update(); }
  function makeCard(piece: RemotePiece, photo?: RemotePhoto, signedUrl?: string) {
    const article = document.createElement('article'), type = piece.object_types?.name || 'Sense tipologia', year = String(piece.production_year_start || piece.period_label || 'Sense data'), tags = (piece.object_tags || []).map(row => row.tags?.normalized_name || row.tags?.name).filter(Boolean) as string[], visual = document.createElement('div'); article.className = 'piece-card'; article.dataset.piece = ''; article.dataset.decade = piece.production_year_start ? String(Math.floor(piece.production_year_start / 10) * 10) : ''; article.dataset.type = type; article.dataset.location = piece.cabinets?.building || ''; article.dataset.tags = tags.join('|'); article.dataset.searchText = [piece.title, piece.manufacturer, piece.model, year, type, ...tags].filter(Boolean).join(' '); visual.className = 'piece-visual';
    const fallback = document.createElement('p'); fallback.className = 'photo-fallback'; fallback.textContent = 'Fotografia pendent';
    if (photo && signedUrl) { const image = document.createElement('img'); image.className = 'piece-image'; image.src = signedUrl; image.alt = photo.alt_text || ''; image.width = 640; image.height = 480; image.loading = 'lazy'; image.decoding = 'async'; fallback.hidden = true; image.addEventListener('error', () => { image.remove(); fallback.hidden = false; }, { once: true }); visual.append(image, fallback); } else visual.append(fallback);
    const content = document.createElement('div'), eyebrow = document.createElement('p'), heading = document.createElement('h3'), titleLink = document.createElement('a'), description = document.createElement('p'), tagList = document.createElement('div'), meta = document.createElement('div'), location = document.createElement('span'), cta = document.createElement('a'); content.className = 'piece-content'; eyebrow.className = 'eyebrow'; eyebrow.textContent = `${year} · ${type}`; titleLink.dataset.detailLink = ''; titleLink.href = detailHref(piece.id); titleLink.textContent = piece.title; heading.append(titleLink); description.textContent = piece.description || [piece.manufacturer, piece.model].filter(Boolean).join(' · ') || 'Fitxa del Museu d’Informàtica.'; tagList.className = 'hashtag-list'; tags.slice(0, 2).forEach(tag => { const item = document.createElement('span'); item.className = 'hashtag'; item.textContent = `#${tag}`; tagList.append(item); }); content.append(eyebrow, heading, description, tagList); meta.className = 'piece-meta'; location.className = 'tag'; location.textContent = piece.cabinets?.building || 'Ubicació en revisió'; cta.className = 'piece-cta'; cta.dataset.detailLink = ''; cta.href = detailHref(piece.id); cta.append('Descobreix la peça ', Object.assign(document.createElement('span'), { ariaHidden: 'true', textContent: '→' })); meta.append(location, cta); article.append(visual, content, meta); return article;
  }
  function showNotice(message: string) { if (notice) { notice.textContent = message; notice.hidden = false; } }
  search?.addEventListener('input', update); filters.forEach(filter => filter.addEventListener('change', update)); document.addEventListener('change', event => { if ((event.target as HTMLElement).matches('[data-tag-filter]')) update(); }); document.querySelector<HTMLButtonElement>('[data-filter-reset]')?.addEventListener('click', () => { if (search) search.value = ''; filters.forEach(filter => filter.value = ''); document.querySelectorAll<HTMLInputElement>('[data-tag-filter]').forEach(input => input.checked = false); update(); }); hydrateControls();
  if (supabase && grid) {
    try {
      const limit = Number(grid.dataset.limit) || undefined;
      let query = supabase.from('catalog_objects').select('id,title,description,manufacturer,model,production_year_start,period_label,object_types(name),cabinets(building),object_tags(tags(name,normalized_name))').eq('status', 'published').order('published_at', { ascending: false });
      if (limit) query = query.limit(limit);
      const { data, error } = await query;
      if (error) { showNotice('No s’ha pogut carregar el catàleg actualitzat. Es mostra la mostra local.'); }
      else if (data?.length) {
        const remote = data as unknown as RemotePiece[], ids = remote.map(piece => piece.id);
        const { data: rows, error: photosError } = await supabase.from('object_photos').select('object_id,storage_path,alt_text').in('object_id', ids).order('position');
        const photos = new Map<string, RemotePhoto>();
        if (photosError) showNotice('El catàleg s’ha carregat parcialment: algunes fotografies no estan disponibles.');
        else ((rows || []) as RemotePhoto[]).forEach(photo => { if (!photos.has(photo.object_id)) photos.set(photo.object_id, photo); });
        const paths = [...photos.values()].map(photo => photo.storage_path), signed = new Map<string, string>();
        if (paths.length) {
          const { data: urls, error: urlsError } = await supabase.storage.from('catalog-photos').createSignedUrls(paths, 3600);
          if (urlsError || !urls) showNotice('El catàleg s’ha carregat parcialment: algunes fotografies no estan disponibles.');
          else urls?.forEach(file => { if (file.path && file.signedUrl) signed.set(file.path, file.signedUrl); });
        }
        grid.replaceChildren(...remote.map(piece => { const photo = photos.get(piece.id); return makeCard(piece, photo, photo ? signed.get(photo.storage_path) : undefined); }));
        hydrateControls();
      }
    } catch { showNotice('No s’ha pogut carregar el catàleg actualitzat. Es mostra la mostra local.'); }
  }
</script>
