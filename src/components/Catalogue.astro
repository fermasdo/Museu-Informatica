---
import { pieces } from '../data/pieces';
import PieceCard from './PieceCard.astro';
const { limit } = Astro.props as { limit?: number };
const shown = limit ? pieces.slice(0, limit) : pieces;
---
<section class="catalogue" aria-labelledby="catalogue-title">
  <div class="section-heading"><p class="eyebrow">COL·LECCIÓ VIVA</p><h2 id="catalogue-title">{limit ? 'Una selecció per començar' : 'Explora les peces'}</h2></div>
   {!limit && <div class="filters" aria-label="Filtra el catàleg"><label>Cerca <input type="search" placeholder="Nom, any o paraula…" data-search /></label><label>Dècada <select data-filter="decade"><option value="">Totes</option><option>1960</option><option>1980</option><option>1990</option><option>2000</option></select></label><label>Tipologia <select data-filter="type"><option value="">Totes</option><option>Ordinador</option><option>Consola</option><option>Perifèric</option><option>Documentació</option></select></label><label>Edifici <select data-filter="location"><option value="">Tots</option><option>Cicles</option><option>ESO</option><option>Administració</option></select></label><label>Etiqueta <select data-filter="tag"><option value="">Totes</option></select></label><button class="filter-reset" type="button" data-filter-reset>Netejar</button></div>}
  <p class="result-count" data-count aria-live="polite"></p>
  <div class="pieces-grid" data-pieces-grid data-limit={limit ?? ''}>{shown.map((piece) => <PieceCard {piece} />)}</div>
  {limit && <a class="text-link" href={`${import.meta.env.BASE_URL}cataleg/`}>Veure les {pieces.length} peces de mostra <span aria-hidden="true">→</span></a>}
</section>
  <script>
    import { supabase } from '../lib/supabase';
      type RemoteTag = { id: string; name: string; normalized_name: string };
       type RemotePiece = { id: string; title: string; description: string | null; manufacturer: string | null; model: string | null; production_year_start: number | null; period_label: string | null; object_types: { name: string } | null; cabinets: { code: string; building: string; cabinet: string } | null; object_tags: { tags: RemoteTag | null }[] | null };
    type RemotePhoto = { object_id: string; storage_path: string; alt_text: string };
    const grid = document.querySelector<HTMLElement>('[data-pieces-grid]');
    const makeCard = (piece: RemotePiece, photo?: RemotePhoto, imageUrl?: string) => {
      const card = document.createElement('article');
       const year = piece.production_year_start ? String(piece.production_year_start) : piece.period_label || 'Sense data';
      const type = piece.object_types?.name || 'Sense tipologia';
       const location = piece.cabinets ? `${piece.cabinets.code} · ${piece.cabinets.building} · ${piece.cabinets.cabinet}` : 'Ubicació en revisió';
        const tags = (piece.object_tags || []).map(row => row.tags).filter((tag): tag is RemoteTag => Boolean(tag));
        card.className = 'piece-card'; card.dataset.piece = ''; card.dataset.decade = piece.production_year_start ? `${Math.floor(piece.production_year_start / 10) * 10}` : ''; card.dataset.type = type; card.dataset.location = piece.cabinets?.building || location; card.dataset.tag = tags.map(tag => tag.normalized_name).join(' ');
      const makeMark = () => {
        const mark = document.createElement('div');
        mark.className = 'piece-mark';
        mark.setAttribute('aria-hidden', 'true');
        mark.textContent = (piece.manufacturer || type).slice(0, 3).toUpperCase();
        return mark;
      };
      const image = photo && imageUrl ? document.createElement('img') : null;
      if (image && photo && imageUrl) {
        image.className = 'piece-image'; image.src = imageUrl; image.alt = photo.alt_text; image.width = 640; image.height = 420; image.loading = 'lazy'; image.decoding = 'async';
        image.addEventListener('error', () => image.replaceWith(makeMark()), { once: true });
      }
      const details = document.createElement('div');
      const eyebrow = document.createElement('p'); eyebrow.className = 'eyebrow'; eyebrow.textContent = `${year} · ${type}`;
      const heading = document.createElement('h3'); const link = document.createElement('a'); link.href = `${import.meta.env.BASE_URL}cataleg/detall/?id=${encodeURIComponent(piece.id)}`; link.textContent = piece.title; heading.append(link);
      const note = document.createElement('p'); note.textContent = piece.description || [piece.manufacturer, piece.model].filter(Boolean).join(' · ') || 'Fitxa del Museu d’Informàtica.';
       const meta = document.createElement('div'); meta.className = 'piece-meta';
       const tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = location;
       const index = document.createElement('span'); index.className = 'piece-index'; index.textContent = `REF. ${(piece.manufacturer || type).slice(0, 3).toUpperCase()}`;
        const tagList = document.createElement('div'); tagList.className = 'hashtag-list'; tags.slice(0, 2).forEach(item => { const hashtag = document.createElement('span'); hashtag.className = 'hashtag'; hashtag.textContent = `#${item.normalized_name || item.name}`; tagList.append(hashtag); }); if (tags.length > 2) { const more = document.createElement('span'); more.className = 'hashtag'; more.textContent = `+${tags.length - 2}`; more.setAttribute('aria-label', `${tags.length - 2} etiquetes més`); tagList.append(more); } meta.append(tag, index); details.append(eyebrow, heading, note, tagList); card.append(image || makeMark(), details, meta); return card;
    };
    if (supabase && grid) {
      const limit = Number(grid.dataset.limit) || undefined;
        let query = supabase.from('catalog_objects').select('id, title, description, manufacturer, model, production_year_start, period_label, object_types(name), cabinets(code, building, cabinet), object_tags(tags(id, name, normalized_name))').eq('status', 'published').order('published_at', { ascending: false });
      if (limit) query = query.limit(limit);
      const { data, error } = await query;
      if (!error && data?.length) {
        // Supabase cannot infer this many-to-one relationship without generated database types.
        const remotePieces = data as unknown as RemotePiece[];
        const shownPieces = limit ? remotePieces.slice(0, limit) : remotePieces;
        const { data: photos } = await supabase.from('object_photos').select('object_id, storage_path, alt_text').in('object_id', shownPieces.map(piece => piece.id)).order('position');
        const primaryPhotos = new Map<string, RemotePhoto>();
        ((photos ?? []) as RemotePhoto[]).forEach(photo => {
          if (!primaryPhotos.has(photo.object_id)) primaryPhotos.set(photo.object_id, photo);
        });
        const photoPaths = [...primaryPhotos.values()].map(photo => photo.storage_path);
        const signedUrls = new Map<string, string>();
        if (photoPaths.length) {
          const { data: signedPhotos } = await supabase.storage.from('catalog-photos').createSignedUrls(photoPaths, 60 * 60);
          signedPhotos?.forEach(({ path, signedUrl }) => {
            if (path && signedUrl) signedUrls.set(path, signedUrl);
          });
        }
        grid.replaceChildren(...shownPieces.map(piece => {
          const photo = primaryPhotos.get(piece.id);
          return makeCard(piece, photo, photo ? signedUrls.get(photo.storage_path) : undefined);
        }));
        populateFilters(remotePieces);
        document.dispatchEvent(new Event('catalogue:updated'));
      }
    }
    function populateFilters(data: RemotePiece[]) {
       const values = { type: new Set(data.map(p => p.object_types?.name).filter(Boolean)), location: new Set(data.map(p => p.cabinets?.building).filter(Boolean)), tag: new Set(data.flatMap(p => (p.object_tags || []).map(row => row.tags?.normalized_name).filter(Boolean))) };
      (Object.entries(values) as [string, Set<string>][]).forEach(([key, choices]) => {
        const select = document.querySelector<HTMLSelectElement>(`[data-filter="${key}"]`); if (!select) return;
        [...choices].forEach(value => { if (![...select.options].some(option => option.value === value)) { const option = new Option(value, value); select.add(option); } });
      });
    }
  </script>
  {!limit && <script>
   const search = document.querySelector<HTMLInputElement>('[data-search]');
  const filters = [...document.querySelectorAll<HTMLSelectElement>('[data-filter]')];
   const count = document.querySelector<HTMLElement>('[data-count]');
   const reset = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
   function update() { const term = search?.value.toLowerCase() ?? ''; let visible = 0; document.querySelectorAll<HTMLElement>('[data-piece]').forEach(card => { const matches = !term || card.textContent?.toLowerCase().includes(term); const choices = filters.every(f => !f.value || card.dataset[f.dataset.filter!] === f.value); card.hidden = !(matches && choices); if (!card.hidden) visible++; }); if (count) count.textContent = `${visible} ${visible === 1 ? 'peça trobada' : 'peces trobades'}`; }
    search?.addEventListener('input', update); filters.forEach(filter => filter.addEventListener('change', update)); reset?.addEventListener('click', () => { if (search) search.value = ''; filters.forEach(filter => filter.value = ''); update(); }); update();
   document.addEventListener('catalogue:updated', update);
</script>}
