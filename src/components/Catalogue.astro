---
import { pieces } from '../data/pieces';
import PieceCard from './PieceCard.astro';
const { limit } = Astro.props as { limit?: number };
const shown = limit ? pieces.slice(0, limit) : pieces;
---
<section class="catalogue" aria-labelledby="catalogue-title">
  <div class="section-heading"><p class="eyebrow">COL·LECCIÓ VIVA</p><h2 id="catalogue-title">{limit ? 'Una selecció per començar' : 'Explora les peces'}</h2></div>
  {!limit && <div class="filters" aria-label="Filtra el catàleg"><label>Cerca <input type="search" placeholder="Nom, any o paraula…" data-search /></label><label>Dècada <select data-filter="decade"><option value="">Totes</option><option>1960</option><option>1980</option><option>1990</option><option>2000</option></select></label><label>Tipologia <select data-filter="type"><option value="">Totes</option><option>Ordinador</option><option>Consola</option><option>Perifèric</option><option>Documentació</option></select></label><label>Ubicació <select data-filter="location"><option value="">Totes</option><option>Corredor A</option><option>Corredor B</option><option>Biblioteca</option></select></label></div>}
  <p class="result-count" data-count aria-live="polite"></p>
  <div class="pieces-grid">{shown.map((piece) => <PieceCard {piece} />)}</div>
  {limit && <a class="text-link" href={`${import.meta.env.BASE_URL}cataleg/`}>Veure les {pieces.length} peces de mostra <span aria-hidden="true">→</span></a>}
</section>
{!limit && <script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-piece]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const filters = [...document.querySelectorAll<HTMLSelectElement>('[data-filter]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  function update() { const term = search?.value.toLowerCase() ?? ''; let visible = 0; cards.forEach(card => { const matches = !term || card.textContent?.toLowerCase().includes(term); const choices = filters.every(f => !f.value || card.dataset[f.dataset.filter!] === f.value); card.hidden = !(matches && choices); if (!card.hidden) visible++; }); if (count) count.textContent = `${visible} ${visible === 1 ? 'peça trobada' : 'peces trobades'}`; }
  search?.addEventListener('input', update); filters.forEach(filter => filter.addEventListener('change', update)); update();
</script>}
