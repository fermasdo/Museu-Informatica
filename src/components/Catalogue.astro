---
import { pieces } from '../data/pieces';
import PieceCard from './PieceCard.astro';
const { limit } = Astro.props as { limit?: number };
const shown = limit ? pieces.slice(0, limit) : pieces;
---
<section class="catalogue" aria-label="Catàleg">
  {limit && <div class="section-heading"><div><h2>Una selecció per començar</h2></div></div>}
  {!limit && <form class="catalogue-query" data-catalogue-filters aria-label="Cerca i filtres del catàleg">
    <label class="catalogue-query-search" for="catalogue-search">Cerca al catàleg<input id="catalogue-search" name="q" type="search" placeholder="Nom, fabricant, model o any" data-search /></label>
    <div class="catalogue-query-refinements">
      <label>Dècada<select name="decade" data-filter="decade"><option value="">Totes</option><option value="1960">1960</option><option value="1980">1980</option><option value="1990">1990</option><option value="2000">2000</option></select></label>
      <label>Tipologia<select name="type" data-filter="type"><option value="">Totes</option></select></label>
      <button class="catalogue-query-reset" type="button" data-filter-reset aria-label="Reinicia la cerca i els filtres" title="Reinicia la cerca i els filtres"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 1 1-2.35-5.65M20 4v7h-7" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter" stroke-width="2"/></svg></button>
    </div>
  </form>}
  <p class="result-count" data-count aria-live="polite"></p>
  <p class="config-notice" data-catalogue-notice role="status" hidden></p>
  <div class="pieces-grid" data-pieces-grid data-limit={limit ?? ''}>{shown.map(piece => <PieceCard {piece} />)}</div>
  <p class="empty-results" data-empty hidden>No hem trobat cap peça amb aquests criteris. Prova de llevar algun filtre.</p>
  {limit && <a class="text-link" href={`${import.meta.env.BASE_URL}cataleg/`}>Veure les {pieces.length} peces de mostra <span aria-hidden="true">→</span></a>}
</section>
<script>
  import { supabase } from '../lib/supabase';
  type RemotePiece = { id: string; inventory_code: string; title: string; description: string | null; manufacturer: string | null; model: string | null; object_type_name: string | null; production_year_start: number | null; production_year_end: number | null; period_label: string | null; published_at: string | null };
  type RemoteTag = { object_id: string; name: string; normalized_name: string };
  type RemotePhoto = { object_id: string; storage_path: string; alt_text: string | null };
  const grid = document.querySelector<HTMLElement>('[data-pieces-grid]');
  const form = document.querySelector<HTMLFormElement>('[data-catalogue-filters]');
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const filters = [...document.querySelectorAll<HTMLSelectElement>('[data-filter]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const notice = document.querySelector<HTMLElement>('[data-catalogue-notice]');
  const normalise = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('ca').trim();
  const detailHref = (id: string) => { const params = new URLSearchParams(window.location.search); params.set('id', id); return `${import.meta.env.BASE_URL}cataleg/detall/?${params}`; };
  function updateUrl() { if (!search) return; const params = new URLSearchParams(); if (search.value) params.set('q', search.value); filters.forEach(filter => { if (filter.value) params.set(filter.dataset.filter!, filter.value); }); history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`); document.querySelectorAll<HTMLAnchorElement>('[data-detail-link]').forEach(link => { const id = new URL(link.href).searchParams.get('id'); if (id) link.href = detailHref(id); }); }
  function update() { const term = normalise(search?.value || ''); let visible = 0; document.querySelectorAll<HTMLElement>('[data-piece]').forEach(card => { const matchesText = !term || normalise(card.dataset.searchText || '').includes(term); const matchesFilters = filters.every(filter => !filter.value || normalise(card.dataset[filter.dataset.filter!] || '') === normalise(filter.value)); card.hidden = !(matchesText && matchesFilters); if (!card.hidden) visible++; }); if (count) count.textContent = `${visible} ${visible === 1 ? 'peça trobada' : 'peces trobades'}`; if (empty) empty.hidden = visible !== 0; updateUrl(); }
  function restore() { const params = new URLSearchParams(location.search); if (search) search.value = params.get('q') || ''; filters.forEach(filter => filter.value = params.get(filter.dataset.filter!) || ''); }
  function hydrateControls() { const cards = [...document.querySelectorAll<HTMLElement>('[data-piece]')]; const types = new Set(cards.map(card => card.dataset.type).filter(Boolean)); const select = document.querySelector<HTMLSelectElement>('[data-filter="type"]'); types.forEach(value => { if (select && value && ![...select.options].some(option => option.value === value)) select.add(new Option(value, value)); }); restore(); update(); }
  function makeCard(piece: RemotePiece, tags: RemoteTag[] = [], photo?: RemotePhoto, signedUrl?: string) { const article = document.createElement('article'); const year = [piece.production_year_start, piece.production_year_end].filter(Boolean).join('–') || piece.period_label || 'Sense data'; const tagNames = tags.map(tag => tag.normalized_name || tag.name); article.className = 'piece-card'; article.dataset.piece = ''; article.dataset.decade = piece.production_year_start ? String(Math.floor(piece.production_year_start / 10) * 10) : ''; article.dataset.type = piece.object_type_name || ''; article.dataset.searchText = [piece.title, piece.manufacturer, piece.model, piece.inventory_code, piece.object_type_name, piece.description, year].filter(Boolean).join(' '); const visual = document.createElement('div'); visual.className = 'piece-visual'; const fallback = document.createElement('p'); fallback.className = 'photo-fallback'; fallback.textContent = 'Fotografia pendent'; if (photo && signedUrl) { const image = document.createElement('img'); image.className = 'piece-image'; image.src = signedUrl; image.alt = photo.alt_text || ''; image.width = 640; image.height = 480; image.loading = 'lazy'; image.decoding = 'async'; fallback.hidden = true; image.addEventListener('error', () => { image.remove(); fallback.hidden = false; }, { once: true }); visual.append(image, fallback); } else visual.append(fallback); const link = document.createElement('a'), content = document.createElement('div'), eyebrow = document.createElement('p'), heading = document.createElement('h3'), description = document.createElement('p'); link.className = 'piece-card-link'; link.dataset.detailLink = ''; link.href = detailHref(piece.id); content.className = 'piece-content'; eyebrow.className = 'eyebrow'; eyebrow.textContent = [year, piece.object_type_name].filter(Boolean).join(' · '); heading.textContent = piece.title; description.textContent = piece.description || [piece.manufacturer, piece.model].filter(Boolean).join(' · ') || 'Fitxa del Museu d’Informàtica.'; content.append(eyebrow, heading, description); if (tagNames.length) { const hashtags = document.createElement('div'); hashtags.className = 'hashtag-list'; tagNames.slice(0, 2).forEach(tag => { const hashtag = document.createElement('span'); hashtag.className = 'hashtag'; hashtag.textContent = `#${tag}`; hashtags.append(hashtag); }); content.append(hashtags); } link.append(visual, content); article.append(link); return article; }
  function showNotice(message: string) { if (notice) { notice.textContent = message; notice.hidden = false; } }
  form?.addEventListener('submit', event => { event.preventDefault(); update(); }); search?.addEventListener('input', update); filters.forEach(filter => filter.addEventListener('change', update)); document.querySelector<HTMLButtonElement>('[data-filter-reset]')?.addEventListener('click', () => { if (search) search.value = ''; filters.forEach(filter => filter.value = ''); update(); search?.focus(); }); hydrateControls();
  if (supabase && grid) { try { const limit = Number(grid.dataset.limit) || undefined; let query = supabase.from('public_catalog_objects').select('id,inventory_code,title,description,manufacturer,model,object_type_name,production_year_start,production_year_end,period_label,published_at').order('published_at', { ascending: false }); if (limit) query = query.limit(limit); const { data, error } = await query; if (error) showNotice('No s’ha pogut carregar el catàleg actualitzat. Es mostra la mostra local.'); else if (data?.length) { const remote = data as unknown as RemotePiece[], ids = remote.map(piece => piece.id); const [photoResult, tagResult] = await Promise.all([supabase.from('public_object_photos').select('object_id,storage_path,alt_text').in('object_id', ids).order('position'), supabase.from('public_catalog_object_tags').select('object_id,name,normalized_name').in('object_id', ids).order('normalized_name')]); const photos = new Map<string, RemotePhoto>(), tagsByObject = new Map<string, RemoteTag[]>(); if (photoResult.error) showNotice('El catàleg s’ha carregat parcialment: algunes fotografies no estan disponibles.'); else ((photoResult.data || []) as RemotePhoto[]).forEach(photo => { if (!photos.has(photo.object_id)) photos.set(photo.object_id, photo); }); if (tagResult.error) showNotice('El catàleg s’ha carregat parcialment: les etiquetes no estan disponibles.'); else ((tagResult.data || []) as RemoteTag[]).forEach(tag => tagsByObject.set(tag.object_id, [...(tagsByObject.get(tag.object_id) || []), tag])); const paths = [...photos.values()].map(photo => photo.storage_path), signed = new Map<string, string>(); if (paths.length) { const { data: urls, error: urlsError } = await supabase.storage.from('catalog-photos').createSignedUrls(paths, 3600); if (urlsError || !urls) showNotice('El catàleg s’ha carregat parcialment: algunes fotografies no estan disponibles.'); else urls.forEach(file => { if (file.path && file.signedUrl) signed.set(file.path, file.signedUrl); }); } grid.replaceChildren(...remote.map(piece => makeCard(piece, tagsByObject.get(piece.id), photos.get(piece.id), signed.get(photos.get(piece.id)?.storage_path || '')))); hydrateControls(); } } catch { showNotice('No s’ha pogut carregar el catàleg actualitzat. Es mostra la mostra local.'); } }
</script>
