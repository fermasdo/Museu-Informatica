---
import '../styles/global.css';
const { title = 'Museu d’Informàtica', description = 'Museu d’Informàtica de l’IES l’Estació, Ontinyent.' } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [['/', 'Inici'], ['/cataleg/', 'Catàleg'], ['/visita/', 'Visita'], ['/recorreguts/', 'Recorreguts'], ['/laboratori/', 'Laboratori'], ['/col·labora/', 'Col·labora']];
const href = (route: string) => `${import.meta.env.BASE_URL}${route.slice(1)}`;
const isCurrent = (route: string) => path === route || (route === '/cataleg/' && path.startsWith('/cataleg/'));
---
<!doctype html>
<html lang="ca">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title} · IES l’Estació</title></head>
  <body>
    <a class="skip-link" href="#contingut">Vés al contingut principal</a>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="Museu d’Informàtica, inici"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu<br /><b>d’Informàtica</b></span></a>
      <nav class="desktop-navigation" aria-label="Navegació principal"><ul>{nav.map(([route, label]) => <li><a href={href(route)} aria-current={isCurrent(route) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
      <div class="header-controls">
        <details class="account-menu" data-account-menu>
          <summary data-account-summary><span class="account-avatar" data-account-avatar aria-hidden="true">?</span><span data-access-status>Accés</span></summary>
          <div class="account-menu-panel">
            <p class="account-identity" data-account-identity hidden><b data-account-name></b><span data-account-role></span></p>
            <div data-account-auth>
              <form data-account-login-form><h2>Inicia sessió</h2><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="current-password" required /></label><button class="account-submit" type="submit">Entrar</button><button class="account-text-button" type="button" data-account-recovery>He oblidat la contrasenya</button><button class="account-text-button" type="button" data-account-show-signup>No tinc compte</button></form>
              <form data-account-signup-form hidden><h2>Crea un compte</h2><label>Nom per mostrar<input name="display_name" autocomplete="name" minlength="2" maxlength="100" required /></label><label>Correu electrònic<input name="email" type="email" autocomplete="email" required /></label><label>Contrasenya<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label><fieldset><legend>Tipus de col·laboració</legend><label><input name="requested_role" type="radio" value="student" required /> Alumnat</label><label><input name="requested_role" type="radio" value="teacher" required /> Professorat</label></fieldset><button class="account-submit" type="submit">Registrar-me</button><button class="account-text-button" type="button" data-account-show-login>Ja tinc compte</button></form>
              <p class="account-message" data-account-message role="status" aria-live="polite"></p>
            </div>
            <div data-account-signed-in hidden><a href={href('/col·labora/')} data-account-space>El meu espai</a><a href={href('/col·labora/#perfil')} data-account-profile>Edita el perfil</a><a href={href('/col·labora/#gestio-cataleg')} data-account-catalogue hidden>Gestiona el catàleg</a><button type="button" data-account-signout>Tanca sessió</button></div>
          </div>
        </details>
        <details class="navigation-menu" data-mobile-menu>
          <summary aria-label="Obri el menú de navegació"><span class="menu-label">Menú</span><span class="menu-icon" aria-hidden="true"></span></summary>
          <div class="navigation-panel">
            <nav aria-label="Navegació principal"><ul>{nav.map(([route, label]) => <li><a href={href(route)} aria-current={isCurrent(route) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
          </div>
        </details>
      </div>
    </header>
    <main id="contingut"><slot /></main>
    <footer class="site-footer"><div><a class="brand" href={import.meta.env.BASE_URL}><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu d’Informàtica<br /><b>IES l’Estació</b></span></a><p>Memòria digital a l’IES l’Estació.<br />Ontinyent</p></div><div><a href="mailto:museu.informatica@iesestacio.com">museu.informatica@iesestacio.com</a><p>Projecte educatiu obert a la comunitat.</p></div></footer>
    <script>
      import { supabase } from '../lib/supabase';
      const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      const accountMenu = document.querySelector<HTMLDetailsElement>('[data-account-menu]');
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const openMenu = [menu, accountMenu].find(item => item?.open);
        if (openMenu) { openMenu.open = false; openMenu.querySelector<HTMLElement>('summary')?.focus(); }
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-account-menu] a, [data-mobile-menu] a').forEach(link => link.addEventListener('click', () => {
        accountMenu && (accountMenu.open = false);
        menu && (menu.open = false);
      }));

       const access = document.querySelector<HTMLElement>('[data-access-status]'); const avatar = document.querySelector<HTMLElement>('[data-account-avatar]'); const identity = document.querySelector<HTMLElement>('[data-account-identity]'); const name = document.querySelector<HTMLElement>('[data-account-name]'); const role = document.querySelector<HTMLElement>('[data-account-role]'); const auth = document.querySelector<HTMLElement>('[data-account-auth]'); const signedIn = document.querySelector<HTMLElement>('[data-account-signed-in]'); const catalogueLink = document.querySelector<HTMLAnchorElement>('[data-account-catalogue]'); const signout = document.querySelector<HTMLButtonElement>('[data-account-signout]'); const loginForm = document.querySelector<HTMLFormElement>('[data-account-login-form]'); const signupForm = document.querySelector<HTMLFormElement>('[data-account-signup-form]'); const accountMessage = document.querySelector<HTMLElement>('[data-account-message]');
      const accountRole = (value: string) => ({ visitor: 'Visitant', student: 'Alumne/a', teacher: 'Professor/a' }[value] || value);
      const initials = (value: string) => value.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '?';
      async function renderAccount(session: import('@supabase/supabase-js').Session | null) {
         if (!access || !avatar || !identity || !name || !role || !auth || !signedIn || !catalogueLink || !signout) return;
         if (!session || !supabase) { access.textContent = 'Accés'; avatar.replaceChildren(); avatar.textContent = '?'; identity.hidden = signedIn.hidden = true; auth.hidden = false; catalogueLink.hidden = true; return; }
         const { data: profile } = await supabase.from('profiles').select('display_name, role').eq('id', session.user.id).maybeSingle();
        const displayName = profile?.display_name || session.user.user_metadata.display_name || 'El meu espai'; access.textContent = displayName; name.textContent = displayName; role.textContent = accountRole(profile?.role || 'visitor'); avatar.replaceChildren(); avatar.textContent = initials(displayName);
         const { data: avatarProfile } = await supabase.from('profiles').select('avatar_path').eq('id', session.user.id).maybeSingle();
         if (avatarProfile?.avatar_path) { const { data } = await supabase.storage.from('profile-avatars').createSignedUrl(avatarProfile.avatar_path, 3600); if (data?.signedUrl) { const image = document.createElement('img'); image.src = data.signedUrl; image.alt = ''; image.width = image.height = 32; image.addEventListener('load', () => avatar.replaceChildren(image), { once: true }); } }
         const { data: administrator } = await supabase.rpc('is_administrator');
         identity.hidden = auth.hidden = true; signedIn.hidden = false; catalogueLink.hidden = !(profile?.role === 'teacher' || administrator === true);
      }
      renderAccount(null);
       const setAccountMessage = (text: string, error = false) => { if (!accountMessage) return; accountMessage.textContent = text; accountMessage.classList.toggle('is-error', error); };
       const showAccountForm = (form: 'login' | 'signup') => { if (!loginForm || !signupForm) return; loginForm.hidden = form !== 'login'; signupForm.hidden = form !== 'signup'; setAccountMessage(''); (form === 'login' ? loginForm : signupForm).querySelector<HTMLInputElement>('input')?.focus(); };
       document.querySelector<HTMLButtonElement>('[data-account-show-signup]')?.addEventListener('click', () => showAccountForm('signup'));
       document.querySelector<HTMLButtonElement>('[data-account-show-login]')?.addEventListener('click', () => showAccountForm('login'));
        document.querySelector<HTMLButtonElement>('[data-account-recovery]')?.addEventListener('click', async () => { if (!supabase || !loginForm) return; const emailInput = loginForm.elements.namedItem('email') as HTMLInputElement | null; if (!emailInput || !emailInput.reportValidity()) return; const email = emailInput.value.trim(); const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: `${window.location.origin}${import.meta.env.BASE_URL}col·labora/` }); setAccountMessage(error ? 'No s’ha pogut enviar l’enllaç ara mateix. Torna-ho a provar més tard.' : 'Si el compte existeix, rebràs un enllaç per restablir la contrasenya.', !!error); });
        loginForm?.addEventListener('submit', async event => { event.preventDefault(); if (!supabase || !loginForm.reportValidity()) return; const data = new FormData(loginForm); const { data: result, error } = await supabase.auth.signInWithPassword({ email: String(data.get('email')), password: String(data.get('password')) }); if (error) { setAccountMessage('No s’ha pogut iniciar la sessió. Revisa les dades i torna-ho a provar.', true); return; } if (result.user) { setAccountMessage('Sessió iniciada. Obrim el teu espai…'); await renderAccount(result.session); if (accountMenu) accountMenu.open = false; window.location.assign(`${import.meta.env.BASE_URL}col·labora/`); } });
        signupForm?.addEventListener('submit', async event => { event.preventDefault(); if (!supabase || !signupForm.reportValidity()) return; const data = new FormData(signupForm); const requestedRole = String(data.get('requested_role')); if (requestedRole !== 'student' && requestedRole !== 'teacher') { setAccountMessage('Tria si vols col·laborar com a alumnat o professorat.', true); return; } const { data: result, error } = await supabase.auth.signUp({ email: String(data.get('email')), password: String(data.get('password')), options: { data: { display_name: String(data.get('display_name')).trim(), requested_role: requestedRole } } }); if (error) { setAccountMessage('No s’ha pogut crear el compte. Revisa les dades i torna-ho a provar.', true); return; } if (result.session) { setAccountMessage('Compte creat. La teua sol·licitud està pendent de validació.'); await renderAccount(result.session); } else setAccountMessage('Compte creat. Revisa el correu per confirmar-lo; la sol·licitud requerirà validació.'); });
       if (supabase) { supabase.auth.getSession().then(({ data }) => renderAccount(data.session)); supabase.auth.onAuthStateChange((_event, session) => renderAccount(session)); signout?.addEventListener('click', async () => { await supabase!.auth.signOut(); setAccountMessage('Sessió tancada.'); }); }
    </script>
  </body>
</html>
