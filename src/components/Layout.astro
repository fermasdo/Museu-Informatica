---
import '../styles/global.css';
const { title = 'Museu d’Informàtica', description = 'Museu d’Informàtica de l’IES l’Estació, Ontinyent.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/', 'Inici'], ['/cataleg/', 'Catàleg'], ['/activitats/', 'Activitats'], ['/col·labora/', 'Col·labora']
];
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · IES l’Estació</title>
  </head>
  <body>
    <a class="skip-link" href="#contingut">Vés al contingut principal</a>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="Museu d’Informàtica, inici"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu<br /><b>d’Informàtica</b></span></a>
      <div class="header-navigation"><nav aria-label="Navegació principal"><ul>{nav.map(([href, label]) => <li><a href={`${import.meta.env.BASE_URL}${href.slice(1)}`} aria-current={path.endsWith(href) ? 'page' : undefined}>{label}</a></li>)}</ul></nav><details class="account-menu"><summary data-access-status>Accés</summary><a href={`${import.meta.env.BASE_URL}col·labora/`} data-access-link>Inicia sessió</a></details></div>
    </header>
    <main id="contingut"><slot /></main>
    <footer class="site-footer"><div><a class="brand" href={import.meta.env.BASE_URL}><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu d’Informàtica<br /><b>IES l’Estació</b></span></a><p>Memòria digital als corredors de FP.<br />Ontinyent</p></div><div><a href="mailto:museu.informatica@iesestacio.com">museu.informatica@iesestacio.com</a><p>Projecte educatiu obert a la comunitat.</p></div></footer>
    <script>
      import { supabase } from '../lib/supabase';
      const access = document.querySelector<HTMLElement>('[data-access-status]');
      const accessLink = document.querySelector<HTMLAnchorElement>('[data-access-link]');
      if (access && supabase) {
        supabase.auth.getSession().then(({ data }) => {
          access.textContent = data.session ? 'El meu espai' : 'Accés'; if (accessLink) accessLink.textContent = data.session ? 'Obrir el tauler' : 'Inicia sessió';
        });
        supabase.auth.onAuthStateChange((_event, session) => {
          access.textContent = session ? 'El meu espai' : 'Accés'; if (accessLink) accessLink.textContent = session ? 'Obrir el tauler' : 'Inicia sessió';
        });
      }
    </script>
  </body>
</html>
