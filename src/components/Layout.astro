---
import '../styles/global.css';
const { title = 'Museu d’Informàtica', description = 'Museu d’Informàtica de l’IES l’Estació, Ontinyent.' } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [['/', 'Inici'], ['/cataleg/', 'Catàleg'], ['/visita/', 'Visita'], ['/recorreguts/', 'Recorreguts'], ['/laboratori/', 'Laboratori']];
const href = (route: string) => `${import.meta.env.BASE_URL}${route.slice(1)}`;
const isCurrent = (route: string) => path === route || (route === '/cataleg/' && path.startsWith('/cataleg/'));
---
<!doctype html>
<html lang="ca">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title} · IES l’Estació</title></head>
  <body>
    <a class="skip-link" href="#contingut">Vés al contingut principal</a>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="Museu d’Informàtica, inici"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu<br /><b>d’Informàtica</b></span></a>
      <details class="navigation-menu" data-menu>
        <summary aria-label="Obri el menú de navegació" aria-expanded="false"><span class="menu-label">Menú</span><span class="menu-icon" aria-hidden="true"></span></summary>
        <div class="navigation-panel">
          <nav aria-label="Navegació principal"><ul>{nav.map(([route, label]) => <li><a href={href(route)} aria-current={isCurrent(route) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
          <details class="account-menu">
            <summary data-account-summary><span class="account-avatar" data-account-avatar aria-hidden="true">?</span><span data-access-status>Accés</span></summary>
            <div class="account-menu-panel"><p class="account-identity" data-account-identity hidden><b data-account-name></b><span data-account-role></span></p><a href={href('/col·labora/')} data-account-space>El meu espai</a><a href={href('/col·labora/#perfil')} data-account-profile hidden>Edita el perfil</a><button type="button" data-account-signout hidden>Tanca sessió</button><a href={href('/col·labora/')} data-account-login>Inicia sessió</a><a href={href('/col·labora/')} data-account-signup>Crea un compte</a></div>
          </details>
        </div>
      </details>
    </header>
    <main id="contingut"><slot /></main>
    <footer class="site-footer"><div><a class="brand" href={import.meta.env.BASE_URL}><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu d’Informàtica<br /><b>IES l’Estació</b></span></a><p>Memòria digital a l’IES l’Estació.<br />Ontinyent</p></div><div><a href="mailto:museu.informatica@iesestacio.com">museu.informatica@iesestacio.com</a><p>Projecte educatiu obert a la comunitat.</p></div></footer>
    <script>
      import { supabase } from '../lib/supabase';
      const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
      const menuSummary = menu?.querySelector('summary');
      menu?.addEventListener('toggle', () => menuSummary?.setAttribute('aria-expanded', String(menu.open)));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menuSummary?.focus(); } });

      const access = document.querySelector<HTMLElement>('[data-access-status]'); const avatar = document.querySelector<HTMLElement>('[data-account-avatar]'); const identity = document.querySelector<HTMLElement>('[data-account-identity]'); const name = document.querySelector<HTMLElement>('[data-account-name]'); const role = document.querySelector<HTMLElement>('[data-account-role]'); const spaceLink = document.querySelector<HTMLAnchorElement>('[data-account-space]'); const profileLink = document.querySelector<HTMLAnchorElement>('[data-account-profile]'); const signout = document.querySelector<HTMLButtonElement>('[data-account-signout]'); const login = document.querySelector<HTMLAnchorElement>('[data-account-login]'); const signup = document.querySelector<HTMLAnchorElement>('[data-account-signup]');
      const accountRole = (value: string) => ({ visitor: 'Visitant', student: 'Alumne/a', teacher: 'Professor/a' }[value] || value);
      const initials = (value: string) => value.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '?';
      async function renderAccount(session: import('@supabase/supabase-js').Session | null) {
        if (!access || !avatar || !identity || !name || !role || !spaceLink || !profileLink || !signout || !login || !signup) return;
        if (!session || !supabase) { access.textContent = 'Accés'; avatar.replaceChildren(); avatar.textContent = '?'; identity.hidden = spaceLink.hidden = profileLink.hidden = signout.hidden = true; login.hidden = signup.hidden = false; return; }
        const { data: profile } = await supabase.from('profiles').select('display_name, role, avatar_path').eq('id', session.user.id).maybeSingle();
        const displayName = profile?.display_name || session.user.user_metadata.display_name || 'El meu espai'; access.textContent = displayName; name.textContent = displayName; role.textContent = accountRole(profile?.role || 'visitor'); avatar.replaceChildren(); avatar.textContent = initials(displayName);
        if (profile?.avatar_path) { const { data } = await supabase.storage.from('profile-avatars').createSignedUrl(profile.avatar_path, 3600); if (data?.signedUrl) { const image = document.createElement('img'); image.src = data.signedUrl; image.alt = ''; image.width = image.height = 32; image.addEventListener('load', () => avatar.replaceChildren(image), { once: true }); } }
        identity.hidden = spaceLink.hidden = profileLink.hidden = signout.hidden = false; login.hidden = signup.hidden = true;
      }
      if (supabase) { supabase.auth.getSession().then(({ data }) => renderAccount(data.session)); supabase.auth.onAuthStateChange((_event, session) => renderAccount(session)); signout?.addEventListener('click', () => supabase!.auth.signOut()); }
    </script>
  </body>
</html>
