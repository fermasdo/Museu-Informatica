---
import '../styles/global.css';
const { title = 'El meu espai', current = 'space' } = Astro.props;
const href = (route: string) => `${import.meta.env.BASE_URL}${route.slice(1)}`;
---
<!doctype html>
<html lang="ca">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} · Museu d’Informàtica</title></head>
  <body class="private-body">
    <a class="skip-link" href="#contingut-privat">Vés al contingut principal</a>
    <header class="private-header">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="Museu d’Informàtica, inici"><svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 32V8h7l9 11 9-11h7v24h-7V18l-9 10-9-10v14z"/><path d="M9 5h22"/></svg><span>Museu<br /><b>d’Informàtica</b></span></a>
      <a class="return-link" href={import.meta.env.BASE_URL}>← Tornar al museu</a>
      <details class="account-menu" data-private-account hidden><summary><span class="account-avatar" data-private-avatar aria-hidden="true">?</span><span data-private-name>Compte</span></summary><div class="account-menu-panel"><button type="button" data-private-signout>Tanca sessió</button></div></details>
    </header>
    <nav class="private-nav" data-private-navigation aria-label="Navegació privada" hidden><a href={href('/espai/')} aria-current={current === 'space' ? 'page' : undefined}>El meu espai</a><a href={href('/perfil/')} aria-current={current === 'profile' ? 'page' : undefined}>Perfil</a><a href={href('/gestio-cataleg/')} data-private-student-management hidden aria-current={current === 'cataleg' ? 'page' : undefined}>Catàleg</a><a href={href('/gestio-personatges/')} data-private-student-management hidden aria-current={current === 'fitxes' ? 'page' : undefined}>Personatges</a><a href={href('/gestio-anuncis/')} data-private-student-management hidden aria-current={current === 'anuncis' ? 'page' : undefined}>Anuncis</a><a href={href('/gestio-persones/')} data-private-management hidden aria-current={current === 'usuaris' ? 'page' : undefined}>Usuaris</a><a href={href('/gestio-donacions/')} data-private-management hidden aria-current={current === 'donacions' ? 'page' : undefined}>Donacions</a></nav>
    <main id="contingut-privat" data-private-content tabindex="-1" hidden><slot /></main>
    <section class="private-service-notice" data-private-service-notice hidden aria-labelledby="private-service-title"><h1 id="private-service-title">Accés no disponible</h1><p data-private-service-message></p><p><button class="link-button" type="button" data-private-restricted-signout>Tanca sessió</button> · <a href={href('/col·labora/')}>Torna a l’accés</a></p></section>
    <script>
      import { supabase } from '../lib/supabase';
      const base = import.meta.env.BASE_URL;
      const initials = (value: string) => value.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join('').toUpperCase() || '?';
       const notice = (text: string) => { const target = document.querySelector<HTMLElement>('[data-private-service-notice]'); const message = document.querySelector<HTMLElement>('[data-private-service-message]'); if (target && message) { message.textContent = text; target.hidden = false; } };
       const lockPrivateUI = () => { document.querySelector<HTMLElement>('[data-private-navigation]')?.replaceChildren(); document.querySelector<HTMLElement>('[data-private-content]')?.replaceChildren(); };
       async function account() {
         if (!supabase) { notice('El servei de compte no està disponible ara mateix.'); return; }
         try {
            const { data: { session }, error: sessionError } = await supabase.auth.getSession();
            if (sessionError) throw sessionError;
            if (!session) { window.location.replace(`${base}col·labora/`); return; }
            const { data: { user }, error: userError } = await supabase.auth.getUser();
            if (userError || !user) { window.location.replace(`${base}col·labora/`); return; }
            const [{ data: activeConfirmed, error: activeError }, { data: profile, error: profileError }, { data: administrator, error: administratorError }] = await Promise.all([
              supabase.rpc('is_active_confirmed_user'),
              supabase.from('profiles').select('display_name, role, approval_status, avatar_path, account_status').eq('id', session.user.id).maybeSingle(),
              supabase.rpc('is_administrator')
            ]);
            if (activeError || profileError || administratorError) throw activeError || profileError || administratorError;
            if (!user.email_confirmed_at) { lockPrivateUI(); notice('Confirma el teu correu electrònic abans d’accedir a l’espai privat.'); return; }
            if (activeConfirmed !== true) { lockPrivateUI(); notice(profile?.account_status === 'suspended' ? 'Aquest compte està suspés. Si creus que és un error, contacta amb el centre.' : 'Aquest compte no està actiu. Contacta amb el centre per revisar-ne l’accés.'); return; }
           const name = profile?.display_name || session.user.email || 'Compte';
           document.querySelector<HTMLElement>('[data-private-name]')!.textContent = name;
           const avatar = document.querySelector<HTMLElement>('[data-private-avatar]')!;
           avatar.replaceChildren(); avatar.textContent = initials(name);
           if (profile?.avatar_path) {
             const { data, error } = await supabase.storage.from('profile-avatars').createSignedUrl(profile.avatar_path, 3600);
             if (!error && data?.signedUrl) { const image = new Image(40, 40); image.alt = ''; image.src = data.signedUrl; image.onload = () => avatar.replaceChildren(image); }
           }
              const canManage = profile?.role === 'teacher' || administrator === true;
              const approvedStudent = profile?.role === 'student' && profile.approval_status === 'approved';
              document.querySelectorAll<HTMLElement>('[data-private-management]').forEach(link => link.hidden = !canManage);
              document.querySelectorAll<HTMLElement>('[data-private-student-management], [data-space-student-management]').forEach(link => link.hidden = !(canManage || approvedStudent));
            document.querySelector<HTMLElement>('[data-private-account]')!.hidden = false;
            document.querySelector<HTMLElement>('[data-private-navigation]')!.hidden = false;
            document.querySelector<HTMLElement>('[data-private-content]')!.hidden = false;
          } catch {
            lockPrivateUI();
            notice('No s’ha pogut carregar el teu compte. Pots tornar a intentar l’accés.');
         }
       }
       document.querySelector<HTMLButtonElement>('[data-private-signout]')?.addEventListener('click', async () => { await supabase?.auth.signOut(); window.location.assign(`${base}col·labora/`); });
       document.querySelector<HTMLButtonElement>('[data-private-restricted-signout]')?.addEventListener('click', async () => { await supabase?.auth.signOut(); window.location.assign(`${base}col·labora/`); });
      account();
    </script>
  </body>
</html>
